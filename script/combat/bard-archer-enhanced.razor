        foreach archery_mob in list__provo_candidates
            if not inlist 'list__archery_picked' archery_mob
                pushlist 'list__archery_picked' archery_mob
            endif
        endfor

        if timer "timer__archery_resync" >= interval__archery_resync
            @setvar! var__archery_active 0
            @setvar! var__archery_finisher_active 0
            settimer "timer__archery_resync" 0
        endif

        clearlist 'list__archery_near'

        if var__fighting = 1 and list 'list__archery_picked' >= 2
            foreach archery_mob in list__archery_picked
                if find archery_mob ground -1 -1 config__acquire_range as alias__archery_mob
                    if not dead alias__archery_mob
                        if find archery_mob ground -1 -1 config__target_range
                            pushlist 'list__archery_near' archery_mob
                        endif
                    endif
                endif
            endfor
        endif

        if list 'list__archery_near' >= 2
            @setvar! var__archery_pack 1
            settimer "timer__archery_pack" 0
        elseif timer "timer__archery_pack" >= interval__archery_pack_hold
            @setvar! var__archery_pack 0
        endif

        if diffhits > config__fowling_enter_diff
            @setvar! var__archery_hurt 1
        elseif diffhits < config__fowling_leave_diff
            @setvar! var__archery_hurt 0
        endif

        if var__archery_hurt = 1
            @setvar! var__archery_want 2
        elseif var__archery_pack = 1 and config__archery_stance_pack != 0
            @setvar! var__archery_want config__archery_stance_pack
        else
            @setvar! var__archery_want config__archery_stance_main
        endif

        if var__archery_pack = 1 and config__archery_finisher_pack != 0
            @setvar! var__archery_finisher_want config__archery_finisher_pack
        else
            @setvar! var__archery_finisher_want config__archery_finisher_main
        endif

        @setvar! var__archery_read 0

        if var__archery_disabled = 0 and var__archery_want != var__archery_active
            @setvar! var__archery_read 1
        elseif var__archery_finisher_off = 0 and var__archery_finisher_want != 0 and var__archery_finisher_want != var__archery_finisher_active
            @setvar! var__archery_read 1
        endif

        if var__archery_read = 1 and timer "timer__archery_retry" >= interval__archery_retry
            settimer "timer__archery_retry" 0

            if findtype 11886 backpack as alias__archery_codex
                getlabel alias__archery_codex label__archery_codex

                if var__archery_disabled = 0
                    if "Arcane" in label__archery_codex and "Fowling" in label__archery_codex
                        @setvar! var__archery_disabled 1
                    elseif "Arcane" in label__archery_codex
                        @setvar! var__archery_active 1
                    elseif "Fowling" in label__archery_codex
                        @setvar! var__archery_active 2
                    elseif "Incendiary" in label__archery_codex
                        @setvar! var__archery_active 3
                    elseif "Longshot" in label__archery_codex
                        @setvar! var__archery_active 4
                    elseif "Maiming" in label__archery_codex
                        @setvar! var__archery_active 5
                    else
                        @setvar! var__archery_disabled 1
                    endif

                    if var__archery_disabled = 1
                        overhead "[ archery stance, off ]" 254
                        if config__sysmsg = 1
                            sysmsg "Archery codex label names no single stance, the stance stands down: {{label__archery_codex}}" 88
                        endif
                    endif
                endif

                if var__archery_finisher_off = 0 and var__archery_finisher_want != 0
                    if "Ricochet" in label__archery_codex and "Pincushion" in label__archery_codex
                        @setvar! var__archery_finisher_off 1
                    elseif "Ricochet" in label__archery_codex
                        @setvar! var__archery_finisher_active 1
                    elseif "Pincushion" in label__archery_codex
                        @setvar! var__archery_finisher_active 2
                    else
                        @setvar! var__archery_finisher_off 1
                    endif

                    if var__archery_finisher_off = 1
                        overhead "[ archery finisher, off ]" 254
                        if config__sysmsg = 1
                            sysmsg "Archery codex label names no single finisher, the finisher stands down: {{label__archery_codex}}" 88
                        endif
                    elseif var__archery_finisher_want != var__archery_finisher_active
                        if var__archery_finisher_want = 1
                            say "[ArcheryFinisher1"
                        elseif var__archery_finisher_want = 2
                            say "[ArcheryFinisher2"
                        endif

                        @setvar! var__archery_finisher_active var__archery_finisher_want
                        if config__sysmsg = 1
                            sysmsg "Archery finisher switch: slot {{var__archery_finisher_want}}." 88
                        endif
                        if config__chatty = 1
                            if var__archery_finisher_want = 1
                                overhead "[ archery, ricochet ]" 290
                            elseif var__archery_finisher_want = 2
                                overhead "[ archery, pincushion ]" 290
                            endif
                        endif
                        wait wait__short
                    endif
                endif

                if var__archery_disabled = 0 and var__archery_want != var__archery_active
                    if config__sysmsg = 1
                        sysmsg "Archery stance switch: slot {{var__archery_active}} to {{var__archery_want}}." 88
                    endif

                    if var__archery_want = 1
                        say "[ArcheryAmmunition1"
                    elseif var__archery_want = 2
                        say "[ArcheryAmmunition2"
                    elseif var__archery_want = 3
                        say "[ArcheryAmmunition3"
                    elseif var__archery_want = 4
                        say "[ArcheryAmmunition4"
                    elseif var__archery_want = 5
                        say "[ArcheryAmmunition5"
                    endif

                    @setvar! var__archery_active var__archery_want
                    settimer "timer__archery_resync" 0
                endif
            elseif timer "timer__message" >= interval__message
                overhead "[ archery codex, out ]" 254
                settimer "timer__message" 0
            endif
        endif
    endif

    if var__fighting = 1
        # --------------------------------------------------------------------------------
        # DISCO                                                    module/bard/disco.razor
        # --------------------------------------------------------------------------------
        if timer "timer__disco_seen" >= interval__disco_seen
            @setvar! var__disco_seen 0
        elseif config__keep_virtuoso = 1 and var__disco_seen != 0 and not findbuff "Virtuoso"
            @setvar! var__disco_seen 0
            @setvar! var__disco_again 1
        endif

        if var__combat_target != var__disco_seen and cooldown "disco" = 0 and cooldown "music" = 0 and skill "Discordance" > 0 and not warmode and var__instrument_ok = 1 and var__my_instrument != 0 and not targetexists and not casting
            if find var__combat_target ground -1 -1 config__target_range as alias__disco_target
                @unsetvar! label__disco_target
                @setvar! label__disco_target 0
                getlabel alias__disco_target label__disco_target

                if label__disco_target = 0
                    # No label, no cast decision.
                elseif "discord" in label__disco_target and var__disco_again = 0
                    @setvar! var__disco_seen var__combat_target
                    settimer "timer__disco_seen" 0
                elseif not warmode and not targetexists and not casting
                    @setvar! var__disco_again 0

                    if insysmsg "What instrument shall you play"
                        # Read off before this request.
                    endif

                    useskill 'Discordance'
                    waitfortarget wait__bard_target

                    if not warmode and targetexists and insysmsg "What instrument shall you play"
                        target var__my_instrument
                        waitfortarget wait__bard_target

                        if insysmsg "That is not a musical instrument"
                            @setvar! var__my_instrument 0
                        endif
                    endif

                    if find lastharmful ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target and var__target_hold != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__disco_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    settimer "timer__disco_target" 0

                    while targetexists and not warmode and timer "timer__disco_target" < wait__bard_target
                        if dead alias__disco_target or var__combat_target != alias__disco_target
                            hotkey "Cancel Current Target"
                            wait wait__short
                        else
                            target alias__disco_target
                            wait wait__short
                        endif
                    endwhile

                    if targetexists and not warmode
                        hotkey "Cancel Current Target"
                    endif

                    wait wait__short
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # PEACE                                                    module/bard/peace.razor
        # --------------------------------------------------------------------------------
        if timer "timer__peace_seen" >= interval__peace_seen and cooldown "peace/provo" = 0 and cooldown "music" = 0 and skill "Peacemaking" > 0 and not warmode and var__instrument_ok = 1 and var__my_instrument != 0 and not targetexists and not casting
            if find var__combat_target ground -1 -1 config__target_range as alias__peace_target
                @unsetvar! label__peace_target
                @setvar! label__peace_target 0
                getlabel alias__peace_target label__peace_target

                if label__peace_target = 0
                    # No label, no cast decision.
                elseif "pacified" in label__peace_target or "barding break" in label__peace_target or "provoked" in label__peace_target
                    settimer "timer__target_grace" 0
                    settimer "timer__peace_seen" 0
                elseif not warmode and not targetexists and not casting
                    if insysmsg "What instrument shall you play"
                        # Read off before this request.
                    endif

                    useskill 'Peacemaking'
                    waitfortarget wait__bard_target

                    if not warmode and targetexists and insysmsg "What instrument shall you play"
                        target var__my_instrument
                        waitfortarget wait__bard_target

                        if insysmsg "That is not a musical instrument"
                            @setvar! var__my_instrument 0
                        endif
                    endif

                    if find lastharmful ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target and var__target_hold != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__peace_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    settimer "timer__peace_target" 0

                    while targetexists and not warmode and timer "timer__peace_target" < wait__bard_target
                        if dead alias__peace_target or var__combat_target != alias__peace_target
                            hotkey "Cancel Current Target"
                            wait wait__short
                        else
                            target alias__peace_target
                            wait wait__short
                        endif
                    endwhile

                    if targetexists and not warmode
                        hotkey "Cancel Current Target"
                    endif

                    wait wait__short
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # WEAPON ABILITY                                 module/fight/weapon-ability.razor
        # --------------------------------------------------------------------------------
        if timer "timer__ability" >= interval__ability and not hidden and not queued and not casting and not targetexists and find var__combat_target ground -1 -1 config__ability_range as alias__ability_target
            if not dead alias__ability_target
                @setvar! var__ability_weapon_ok 0

                if config__ability_weapon_graphic = 0
                    @setvar! var__ability_weapon_ok 1
                elseif findtype config__ability_weapon_graphic self as alias__ability_weapon
                    @setvar! var__ability_weapon alias__ability_weapon

                    if findlayer self lefthand as alias__ability_held
                        if alias__ability_held = var__ability_weapon
                            @setvar! var__ability_weapon_ok 1
                        endif
                    endif

                    if findlayer self righthand as alias__ability_held
                        if alias__ability_held = var__ability_weapon
                            @setvar! var__ability_weapon_ok 1
                        endif
                    endif
                endif

                if var__ability_weapon_ok = 1
                    if config__ability_main = 1
                        say "[WeaponAbility1"
                    elseif config__ability_main = 2
                        say "[WeaponAbility2"
                    elseif config__ability_main = 3
                        say "[WeaponAbility3"
                    endif

                    settimer "timer__ability" 0
                    if config__sysmsg = 1
                        sysmsg "Weapon ability request: codex {{config__ability_codex}}, slot {{config__ability_main}}. Fires on the next hit." 88
                    endif

                    if config__chatty = 1
                        if config__ability_codex = 2
                            if config__ability_main = 3
                                overhead "[ repeater ]" 219
                            elseif config__ability_main = 2
                                overhead "[ full draw ]" 219
                            elseif config__ability_main = 1
                                overhead "[ skirmish ]" 219
                            endif
                        elseif config__ability_codex = 3
                            if config__ability_main = 1
                                overhead "[ brawl ]" 219
                            elseif config__ability_main = 2
                                overhead "[ haymaker ]" 219
                            elseif config__ability_main = 3
                                overhead "[ takedown ]" 219
                            endif
                        elseif config__ability_main = 3
                            overhead "[ chop ]" 219
                        elseif config__ability_main = 1
                            overhead "[ spinslash ]" 219
                        elseif config__ability_main = 2
                            overhead "[ rend ]" 219
                        endif
                    endif
                endif
            endif
        endif
    else
        # --------------------------------------------------------------------------------
        # BARD SONG                                                 module/bard/song.razor
        # --------------------------------------------------------------------------------
        if var__combat_target = 0 and cooldown "song" = 0 and cooldown "music" = 0 and timer "timer__song_retry" >= interval__song_retry and not warmode and var__instrument_ok = 1 and var__my_instrument != 0 and not targetexists and not casting
            @setvar! var__song_after 0

            if insysmsg "under the effect of a Song"
                # Read off.
            endif

            if insysmsg "use another skill"
                # Read off.
            endif

            if insysmsg "another barding song"
                # Read off.
            endif

            if insysmsg "provoke or pacify another creature"
                # Read off.
            endif

            if var__song_next = 1 and skill "Discordance" > 0 and cooldown "disco" = 0
                useskill 'Discordance'
                @setvar! var__song_after 2
            elseif var__song_next = 2 and skill "Peacemaking" > 0 and cooldown "peace/provo" = 0
                useskill 'Peacemaking'
                @setvar! var__song_after 3
            elseif var__song_next = 3 and skill "Provocation" > 0 and cooldown "peace/provo" = 0
                useskill 'Provocation'
                @setvar! var__song_after 1
            endif

            if var__song_after != 0
                waitfortarget wait__bard_target

                if insysmsg "What instrument shall you play"
                    target var__my_instrument
                    waitfortarget wait__bard_target

                    if insysmsg "That is not a musical instrument"
                        @setvar! var__my_instrument 0
                    endif
                endif

                if targetexists
                    target backpack

                    @setvar! var__song_answer 0

                    for 5
                        if var__song_answer = 0
                            if insysmsg "under the effect of a Song"
                                @setvar! var__song_answer 1
                            elseif insysmsg "use another skill" or insysmsg "another barding song" or insysmsg "provoke or pacify another creature"
                                @setvar! var__song_answer 2
                            else
                                wait wait__short
                            endif
                        endif
                    endfor

                    if var__song_answer = 1
                        @setvar! var__song_next var__song_after
                    else
                        settimer "timer__song_retry" 0
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # SELF BUFFS                                                  module/buff/spells.razor
    # ------------------------------------------------------------------------------------
    if config__use_magery = 1 and var__hold_casts = 0 and not paralyzed and not hidden and not queued and not casting and not targetexists and diffhits < config__buff_max_loss
        if config__buff_when_poisoned = 1 or not poisoned
            if config__warmode_is_manual = 0 or not warmode
                if config__walk_guard = 0 or cooldown "walk" = 0
                    if config__use_reactive_armor = 1 and var__regs_reactive_armor = 1 and mana >= config__mana_reactive_armor and not findbuff "Reactive Armor"
                        cast "Reactive Armor"
                        if config__sysmsg = 1
                            sysmsg "Buff: Reactive Armor." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor
                    elseif config__use_magic_reflect = 1 and var__regs_magic_reflect = 1 and mana >= config__mana_magic_reflect and cooldown "reflect" = 0 and not findbuff "Magic Reflection"
                        cast "Magic Reflection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Magic Reflection." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor
                    elseif config__use_protection = 1 and var__regs_protection = 1 and mana >= config__mana_protection and not findbuff "Protection"
                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            # consumed, nothing else to do
                        endif

                        cast "Protection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Protection." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if not casting
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "beneficial" or targetexists "neutral"
                            target self

                            for 10
                                if findbuff "Protection"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_bless = 1 and var__fighting = 0 and not warmode and var__regs_bless = 1 and mana >= config__mana_bless and not findbuff "Cunning"
                        cast "Bless"
                        if config__sysmsg = 1
                            sysmsg "Buff: Bless." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "beneficial"
                            target self

                            for 10
                                if findbuff "Cunning"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_arch_protection = 1 and var__fighting = 0 and not warmode and var__regs_arch_protection = 1 and mana >= config__mana_arch_protection and not findbuff "Protection"
                        cast "Arch Protection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Arch Protection." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "neutral"
                            target self

                            for 10
                                if findbuff "Protection"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_spell_siphon = 1 and not warmode and var__regs_magic_arrow = 1 and mana >= config__mana_spell_siphon and not findbuff "Spell Siphon" and not findbuff "Magic Reflection"
                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            # consumed, nothing else to do
                        endif

                        cast "Magic Arrow"
                        if config__sysmsg = 1
                            sysmsg "Buff: Magic Arrow on yourself for Spell Siphon." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "harmful"
                            hotkey 'Target Self'
                            wait wait__cast
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # END OF PASS                                                        module/base.razor
    # ------------------------------------------------------------------------------------
    wait wait__poll
endwhile
