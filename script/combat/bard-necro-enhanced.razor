                        elseif timer "timer__vengeful_spirit" >= interval__necro_action
                            @setvar! var__vengeful_state 1
                        endif

                        @setvar! var__wither_state 0

                        if findbuff "Wither"
                            if timer "timer__wither" < interval__summon_cast_by and var__wither_used = 0
                                @setvar! var__wither_state 2
                            endif
                        elseif timer "timer__wither" >= interval__necro_action and diffhits < config__wither_max_loss
                            @setvar! var__wither_state 1
                        endif

                        @setvar! var__wither_path 0

                        if followers < config__summon_followers and mana < config__summon_mana
                            @setvar! var__wither_path 1

                            if list 'list__necro_symbols' >= config__symbols_bank
                                # Full: the next symbol would be lost. Blood Oath at 4
                                # still leaves six.
                            else
                                @setvar! var__hold_symbols 1
                            endif
                        endif

                        if config__walk_guard = 0 or cooldown "walk" = 0
                            if not paralyzed and not queued and not casting and not targetexists
                                if followers >= config__summon_followers and var__combat_target = 0 and mana >= config__summon_mana
                                    if var__vengeful_state = 1 or var__vengeful_state = 3
                                        if var__vengeful_state = 3 or list 'list__necro_symbols' >= config__symbols_vengeful_spirit
                                            @setvar! var__summon_release 0

                                            if timer "timer__summon_age_first" >= var__summon_refresh
                                                @setvar! var__summon_release config__summon_first
                                                settimer "timer__summon_age_first" 0

                                                if config__summon_first = config__summon_second
                                                    settimer "timer__summon_age_second" 0
                                                endif
                                            elseif timer "timer__summon_age_second" >= var__summon_refresh
                                                @setvar! var__summon_release config__summon_second
                                                settimer "timer__summon_age_second" 0
                                            endif

                                            if var__summon_release = 1
                                                say "leech release"
                                            elseif var__summon_release = 2
                                                say "wichy release"
                                            elseif var__summon_release = 3
                                                say "mumi release"
                                            elseif var__summon_release = 5
                                                say "vampa release"
                                            endif

                                            if var__summon_release != 0 and var__summon_release != 4
                                                wait wait__message

                                                if followers >= config__summon_followers
                                                    overhead "[ release, miss ]" 254

                                                    if config__sysmsg = 1
                                                        sysmsg "Summon: release of kind {{var__summon_release}} found no summon." 88
                                                    endif
                                                endif
                                            endif
                                        endif
                                    endif
                                endif

                                if followers < config__summon_followers
                                    @setvar! var__press_vengeful 0
                                    @setvar! var__press_wither 0

                                    if mana >= config__summon_mana
                                        if var__vengeful_state = 1 and list 'list__necro_symbols' >= config__symbols_vengeful_spirit
                                            @setvar! var__press_vengeful 1
                                        endif
                                    elseif var__wither_path = 1
                                        if var__vengeful_state = 1 and var__wither_state = 1
                                            if list 'list__necro_symbols' >= config__symbols_wither_summon
                                                @setvar! var__press_wither 1
                                                @setvar! var__press_vengeful 1
                                            endif
                                        elseif var__vengeful_state = 1 and var__wither_state = 2
                                            if list 'list__necro_symbols' >= config__symbols_vengeful_spirit
                                                @setvar! var__press_vengeful 1
                                            endif
                                        elseif var__vengeful_state = 3 and var__wither_state = 1
                                            if list 'list__necro_symbols' >= config__symbols_wither
                                                @setvar! var__press_wither 1
                                            endif
                                        endif
                                    endif

                                    if var__press_wither = 1
                                        settimer "timer__wither" 0
                                        @setvar! var__wither_used 0
                                        hotkey 'Wither'
                                        wait wait__message

                                        if insysmsg "unholy symbols remaining"
                                            # Its reply, read off so necro/burst does not
                                            # take it for the answer to its own press.
                                        endif

                                        if findbuff "Wither"
                                            @setvar! var__wither_state 2
                                            clearlist 'list__necro_symbols'
                                            @setvar! var__symbols_listed 99

                                            if config__chatty = 1
                                                overhead "[ wither ]" 219
                                            endif
                                        else
                                            @setvar! var__press_vengeful 0

                                            if insysmsg "seconds before you may use that ability again."
                                                # Read off for the same reason.
                                            endif

                                            overhead "[ wither, miss ]" 254
                                        endif
                                    endif

                                    if var__press_vengeful = 1
                                        settimer "timer__vengeful_spirit" 0
                                        hotkey 'Vengeful Spirit'
                                        wait wait__message

                                        if insysmsg "unholy symbols remaining"
                                            # Its reply, read off so necro/burst does not
                                            # take it for the answer to its own press.
                                        endif

                                        if findbuff "Vengeful Spirit"
                                            @setvar! var__vengeful_state 3
                                            clearlist 'list__necro_symbols'
                                            @setvar! var__symbols_listed 99

                                            if config__chatty = 1
                                                overhead "[ vengeful spirit ]" 219
                                            endif
                                        else
                                            if insysmsg "seconds before you may use that ability again."
                                                # Read off for the same reason.
                                            endif

                                            if config__sysmsg = 1
                                                sysmsg "Summon: no Vengeful Spirit buff after the press." 88
                                            endif
                                        endif
                                    endif

                                    @setvar! var__summon_ready 0

                                    if var__vengeful_state = 2 or var__vengeful_state = 3
                                        if timer "timer__vengeful_spirit" < interval__summon_cast_by
                                            if mana >= config__summon_mana or var__wither_state = 2
                                                @setvar! var__summon_ready 1
                                            endif
                                        endif
                                    endif

                                    if var__summon_ready = 1
                                        @setvar! var__summon_pick config__summon_first
                                        @setvar! var__summon_slot 1

                                        if config__summon_first = config__summon_second
                                            if followers > 0
                                                @setvar! var__summon_slot 0
                                            endif
                                        else
                                            @setvar! var__summon_found 0

                                            if config__summon_first = 1
                                                while findtype 24 ground -1 -1 config__summon_range as alias__own_summon
                                                    if not dead alias__own_summon and noto alias__own_summon != "hostile" and noto alias__own_summon != "criminal" and noto alias__own_summon != "enemy" and noto alias__own_summon != "murderer" and noto alias__own_summon != "innocent"
                                                        @setvar! var__summon_found 1
                                                    endif

                                                    @ignore alias__own_summon
                                                endwhile
                                            elseif config__summon_first = 2
                                                while findtype 740 ground -1 -1 config__summon_range as alias__own_summon
                                                    if not dead alias__own_summon and noto alias__own_summon != "hostile" and noto alias__own_summon != "criminal" and noto alias__own_summon != "enemy" and noto alias__own_summon != "murderer" and noto alias__own_summon != "innocent"
                                                        @setvar! var__summon_found 1
                                                    endif

                                                    @ignore alias__own_summon
                                                endwhile
                                            elseif config__summon_first = 3
                                                while findtype 158 ground -1 -1 config__summon_range as alias__own_summon
                                                    if not dead alias__own_summon and noto alias__own_summon != "hostile" and noto alias__own_summon != "criminal" and noto alias__own_summon != "enemy" and noto alias__own_summon != "murderer" and noto alias__own_summon != "innocent"
                                                        @setvar! var__summon_found 1
                                                    endif

                                                    @ignore alias__own_summon
                                                endwhile
                                            elseif config__summon_first = 5
                                                while findtype 722 ground -1 -1 config__summon_range as alias__own_summon
                                                    if not dead alias__own_summon and noto alias__own_summon != "hostile" and noto alias__own_summon != "criminal" and noto alias__own_summon != "enemy" and noto alias__own_summon != "murderer" and noto alias__own_summon != "innocent"
                                                        @setvar! var__summon_found 1
                                                    endif

                                                    @ignore alias__own_summon
                                                endwhile
                                            endif

                                            @clearignore

                                            if var__summon_found = 1
                                                @setvar! var__summon_pick config__summon_second
                                                @setvar! var__summon_slot 2
                                            endif
                                        endif

                                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                            # Read off before the cast.
                                        endif

                                        @setvar! var__summon_cast 1

                                        if var__summon_pick = 1
                                            cast 'Fire Elemental'
                                        elseif var__summon_pick = 2
                                            cast 'Water Elemental'
                                        elseif var__summon_pick = 3
                                            cast 'Earth Elemental'
                                        elseif var__summon_pick = 4
                                            cast 'Air Elemental'
                                        elseif var__summon_pick = 5
                                            cast 'Summon Daemon'
                                        else
                                            @setvar! var__summon_cast 0
                                        endif

                                        if var__summon_cast = 1
                                            if var__summon_slot = 1
                                                settimer "timer__summon_age_first" 0

                                                if config__summon_first = config__summon_second
                                                    settimer "timer__summon_age_second" 0
                                                endif
                                            elseif var__summon_slot = 2
                                                settimer "timer__summon_age_second" 0
                                            endif

                                            if config__sysmsg = 1
                                                sysmsg "Summon: cast kind {{var__summon_pick}}, wither state {{var__wither_state}}." 88
                                            endif

                                            wait wait__short
                                            @setvar! var__summon_cut 0

                                            while casting
                                                if var__summon_cut = 0 and config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                                                    hotkey "> Interrupt"
                                                    @setvar! var__summon_cut 1

                                                    if config__chatty = 1
                                                        overhead "[ summon, cut ]" 254
                                                    endif
                                                endif

                                                wait wait__poll
                                            endwhile

                                            wait wait__short

                                            if insysmsg "You have too many followers to cast that spell."
                                                settimer "timer__summon_refused" 0

                                                if config__sysmsg = 1
                                                    sysmsg "Summon: too many followers, resting." 88
                                                endif
                                            elseif insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                                # Nothing was spent, Wither mana included,
                                                # and the next pass casts again. Read here
                                                # so a later cursor poll does not take it.
                                            elseif var__summon_cut = 0 and var__wither_state = 2
                                                @setvar! var__wither_used 1
                                            endif
                                        endif
                                    endif
                                endif
                            endif
                        endif
                    endif
                endif
            endif
        elseif var__hold_symbols = 1
            @setvar! var__hold_symbols 0
        endif
    elseif var__hold_symbols = 1
        @setvar! var__hold_symbols 0
    endif

    # ------------------------------------------------------------------------------------
    # PROVOKE                                                      module/bard/provo.razor
    # ------------------------------------------------------------------------------------
    if var__provo_added = 1
        settimer "timer__provo_seen" interval__provo_seen
        settimer "timer__provo_retry" interval__provo_retry
    endif

    if var__fighting = 1 and list 'list__provo_candidates' >= 2 and timer "timer__provo_seen" >= interval__provo_seen and timer "timer__provo_retry" >= interval__provo_retry and cooldown "peace/provo" = 0 and cooldown "music" = 0 and skill "Provocation" > 0 and not warmode and var__instrument_ok = 1 and var__my_instrument != 0 and not targetexists and not casting
        settimer "timer__provo_seen" 0
        @setvar! var__provo_first 0
        @setvar! var__provo_second 0
        @setvar! var__provo_dropped 0
        clearlist 'list__provo_keep'

        foreach provo_mob in list__provo_candidates
            if find provo_mob ground -1 -1 config__acquire_range as alias__provo_mob
                if dead alias__provo_mob
                    @setvar! var__provo_dropped 1
                elseif noto alias__provo_mob = "hostile" or noto alias__provo_mob = "criminal" or noto alias__provo_mob = "enemy" or noto alias__provo_mob = "murderer"
                    pushlist 'list__provo_keep' provo_mob

                    if var__provo_second = 0 and not inlist 'list__provo_never' provo_mob
                        if find provo_mob ground -1 -1 config__target_range as alias__provo_near
                            @unsetvar! label__provo_mob
                            @setvar! label__provo_mob 0
                            getlabel alias__provo_near label__provo_mob

                            if label__provo_mob = 0
                                # No label means no known free barding slot.
                            elseif "provoked" in label__provo_mob or "barding break" in label__provo_mob
                                # Busy, or cannot take one now.
                            elseif var__provo_first = 0
                                @setvar! var__provo_first provo_mob
                            else
                                @setvar! var__provo_second provo_mob
                            endif
                        endif
                    endif
                else
                    @setvar! var__provo_dropped 1
                endif
            else
                @setvar! var__provo_dropped 1
            endif
        endfor

        if var__provo_dropped = 1
            clearlist 'list__provo_candidates'

            foreach provo_mob in list__provo_keep
                pushlist 'list__provo_candidates' provo_mob
            endfor
        endif

        if var__provo_second = 0
            settimer "timer__provo_retry" 0
        elseif not warmode and not targetexists and not casting
            if insysmsg "play successfully, provoking"
                # Read off before this round's answer.
            endif

            if insysmsg "too far away"
                # Read off.
            endif

            if insysmsg "Target cannot be seen"
                # Read off.
            endif

            if insysmsg "You must wait a few moments"
                # Read off.
            endif

            if insysmsg "fail to incite anger"
                # Read off.
            endif

            if insysmsg "incite that"
                # Read off.
            endif

            if insysmsg "What instrument shall you play"
                # Read off before this request.
            endif

            useskill 'Provocation'
            waitfortarget wait__bard_target

            if not warmode and targetexists and insysmsg "What instrument shall you play"
                target var__my_instrument
                waitfortarget wait__bard_target

                if insysmsg "That is not a musical instrument"
                    @setvar! var__my_instrument 0
                endif
            endif

            @setvar! var__provo_sent 0
            @setvar! var__provo_done 0
            settimer "timer__provo_target" 0

            while var__provo_done = 0 and not warmode and timer "timer__provo_target" < wait__bard_target
                if targetexists "harmful"
                    if find lastharmful ground -1 -1 config__acquire_range as alias__fresh_target
                        @setvar! var__fresh_serial alias__fresh_target

                        if 0x40000000 > var__fresh_serial and var__combat_target != alias__fresh_target and var__target_hold != alias__fresh_target
                            if not dead alias__fresh_target
                                if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                    @setvar! var__combat_target alias__fresh_target
                                    settimer "timer__target_grace" 0

                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    if find var__provo_first ground -1 -1 config__target_range and find var__provo_second ground -1 -1 config__target_range
                        if not dead var__provo_first and not dead var__provo_second
                            if var__provo_sent = 0
                                @setvar! var__target_hold var__provo_first
                                target var__target_hold
                                @setvar! var__provo_sent 1
                            else
                                @setvar! var__target_hold var__provo_second
                                target var__target_hold
                                @setvar! var__provo_sent 2
                                @setvar! var__provo_done 1
                            endif

                            settimer "timer__provo_target" 0
                            wait wait__short
                        else
                            @setvar! var__provo_done 1
                        endif
                    else
                        @setvar! var__provo_done 1
                    endif
                else
                    wait wait__poll
                endif
            endwhile

            if targetexists "harmful" and not warmode
                hotkey "Cancel Current Target"
                wait wait__short
            endif

            @setvar! var__provo_answer 0

            for 5
                if var__provo_answer = 0 and not warmode
                    if insysmsg "play successfully, provoking"
                        @setvar! var__provo_answer 1
                    elseif insysmsg "fail to incite anger"
                        @setvar! var__provo_answer 2
                    elseif insysmsg "too far away" or insysmsg "Target cannot be seen"
                        @setvar! var__provo_answer 3
                    elseif insysmsg "incite that"
                        @setvar! var__provo_answer 4
                    elseif insysmsg "You must wait a few moments"
                        @setvar! var__provo_answer 5
                    else
                        wait wait__short
                    endif
                endif
            endfor

            if not warmode
                if var__provo_answer = 4
                    pushlist 'list__provo_never' var__provo_first
                    overhead "[ provo, wrong ]" 254 var__provo_first
                elseif var__provo_answer = 5
                    settimer "timer__provo_retry" 0
                elseif var__provo_answer = 0 or var__provo_answer = 2 or var__provo_answer = 3
                    clearlist 'list__provo_keep'

                    foreach provo_mob in list__provo_candidates
                        if provo_mob != var__provo_first
                            pushlist 'list__provo_keep' provo_mob
                        endif
                    endfor

                    clearlist 'list__provo_candidates'

                    foreach provo_mob in list__provo_keep
                        pushlist 'list__provo_candidates' provo_mob
                    endfor

                    pushlist 'list__provo_candidates' var__provo_first
                    if var__provo_answer != 2
                        settimer "timer__provo_retry" 0
                    endif
                endif
            endif
        endif
    endif

    if var__fighting = 1
        # --------------------------------------------------------------------------------
        # DISCO                                                    module/bard/disco.razor
        # --------------------------------------------------------------------------------
        if timer "timer__disco_seen" >= interval__disco_seen
            @setvar! var__disco_seen 0
        elseif config__keep_virtuoso = 1 and var__disco_seen != 0 and not findbuff "Virtuoso"
            @setvar! var__disco_seen 0
            @setvar! var__disco_again 1
        endif

        if var__combat_target != var__disco_seen and cooldown "disco" = 0 and cooldown "music" = 0 and skill "Discordance" > 0 and not warmode and var__instrument_ok = 1 and var__my_instrument != 0 and not targetexists and not casting
            if find var__combat_target ground -1 -1 config__target_range as alias__disco_target
                @unsetvar! label__disco_target
                @setvar! label__disco_target 0
                getlabel alias__disco_target label__disco_target

                if label__disco_target = 0
                    # No label, no cast decision.
                elseif "discord" in label__disco_target and var__disco_again = 0
                    @setvar! var__disco_seen var__combat_target
                    settimer "timer__disco_seen" 0
                elseif not warmode and not targetexists and not casting
                    @setvar! var__disco_again 0

                    if insysmsg "What instrument shall you play"
                        # Read off before this request.
                    endif

                    useskill 'Discordance'
                    waitfortarget wait__bard_target

                    if not warmode and targetexists and insysmsg "What instrument shall you play"
                        target var__my_instrument
                        waitfortarget wait__bard_target

                        if insysmsg "That is not a musical instrument"
                            @setvar! var__my_instrument 0
                        endif
                    endif

                    if find lastharmful ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target and var__target_hold != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__disco_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    settimer "timer__disco_target" 0

                    while targetexists and not warmode and timer "timer__disco_target" < wait__bard_target
                        if dead alias__disco_target or var__combat_target != alias__disco_target
                            hotkey "Cancel Current Target"
                            wait wait__short
                        else
                            target alias__disco_target
                            wait wait__short
                        endif
                    endwhile

                    if targetexists and not warmode
                        hotkey "Cancel Current Target"
                    endif

                    wait wait__short
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # PEACE                                                    module/bard/peace.razor
        # --------------------------------------------------------------------------------
        if timer "timer__peace_seen" >= interval__peace_seen and cooldown "peace/provo" = 0 and cooldown "music" = 0 and skill "Peacemaking" > 0 and not warmode and var__instrument_ok = 1 and var__my_instrument != 0 and not targetexists and not casting
            if find var__combat_target ground -1 -1 config__target_range as alias__peace_target
                @unsetvar! label__peace_target
                @setvar! label__peace_target 0
                getlabel alias__peace_target label__peace_target

                if label__peace_target = 0
                    # No label, no cast decision.
                elseif "pacified" in label__peace_target or "barding break" in label__peace_target or "provoked" in label__peace_target
                    settimer "timer__target_grace" 0
                    settimer "timer__peace_seen" 0
                elseif not warmode and not targetexists and not casting
                    if insysmsg "What instrument shall you play"
                        # Read off before this request.
                    endif

                    useskill 'Peacemaking'
                    waitfortarget wait__bard_target

                    if not warmode and targetexists and insysmsg "What instrument shall you play"
                        target var__my_instrument
                        waitfortarget wait__bard_target

                        if insysmsg "That is not a musical instrument"
                            @setvar! var__my_instrument 0
                        endif
                    endif

                    if find lastharmful ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target and var__target_hold != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__peace_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    settimer "timer__peace_target" 0

                    while targetexists and not warmode and timer "timer__peace_target" < wait__bard_target
                        if dead alias__peace_target or var__combat_target != alias__peace_target
                            hotkey "Cancel Current Target"
                            wait wait__short
                        else
                            target alias__peace_target
                            wait wait__short
                        endif
                    endwhile

                    if targetexists and not warmode
                        hotkey "Cancel Current Target"
                    endif

                    wait wait__short
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # NECRO BURST                                             module/necro/burst.razor
        # --------------------------------------------------------------------------------
        @setvar! var__symbols_spent 0

        if list 'list__necro_symbols' >= config__symbols_blood_oath and followers > 0 and var__hold_symbols = 0 and timer "timer__blood_oath" >= interval__necro_action and not targetexists and not casting
            hotkey 'Blood Oath'
            wait wait__message

            if insysmsg "unholy symbols remaining"
                settimer "timer__blood_oath" 0
                @setvar! var__symbols_spent 1

                if config__chatty = 1
                    overhead "[ blood oath ]" 219
                endif
            elseif insysmsg "seconds before you may use that ability again."
                settimer "timer__blood_oath" 0
            endif
        elseif list 'list__necro_symbols' >= config__symbols_corpse_skin and var__hold_symbols = 0 and not warmode and timer "timer__corpse_skin" >= interval__necro_action and cooldown "walk" = 0 and not targetexists and not casting
            hotkey 'Corpse Skin'
            wait wait__message

            if insysmsg "unholy symbols remaining"
                settimer "timer__corpse_skin" 0
                @setvar! var__symbols_spent 1

                if config__chatty = 1
                    overhead "[ corpse skin ]" 219
                endif
            elseif insysmsg "seconds before you may use that ability again."
                settimer "timer__corpse_skin" 0
            endif
        elseif list 'list__necro_symbols' >= config__symbols_evil_omen and var__hold_symbols = 0 and not warmode and timer "timer__evil_omen" >= interval__necro_action and cooldown "walk" = 0 and not targetexists and not casting
            hotkey 'Evil Omen'
            wait wait__message

            if insysmsg "unholy symbols remaining"
                settimer "timer__evil_omen" 0
                @setvar! var__symbols_spent 1

                if config__chatty = 1
                    overhead "[ evil omen ]" 219
                endif
            elseif insysmsg "seconds before you may use that ability again."
                settimer "timer__evil_omen" 0
            endif
        endif

        # --------------------------------------------------------------------------------
        # OPENER                                              module/magery/rotation.razor
        # --------------------------------------------------------------------------------
        if timer "timer__magic_window" >= interval__magic_window
            clearlist 'list__magic_drained_targets'
            clearlist 'list__magic_cursed_targets'
            settimer "timer__magic_window" 0
