# module/fight/rearm.razor
# ----------------------------------------------------------------------------------------
if config__rearm_follow_hands = 1
    if not lhandempty or not rhandempty
        @setvar! var__rearm_left 0
        @setvar! var__rearm_right 0
    endif
endif

if findlayer self lefthand as alias__rearm_left
    @setvar! var__rearm_left alias__rearm_left

    if config__sysmsg = 1
        sysmsg "Rearm: two-handed layer remembered, serial={{alias__rearm_left}}." 88
    endif
endif

if findlayer self righthand as alias__rearm_right
    @setvar! var__rearm_right alias__rearm_right

    if config__sysmsg = 1
        sysmsg "Rearm: one-handed layer remembered, serial={{alias__rearm_right}}." 88
    endif
endif


# ----------------------------------------------------------------------------------------
# recipe/pvp-recipe.razor
# ----------------------------------------------------------------------------------------
overhead "[ pvp, on ]" 290
if config__sysmsg = 1
    sysmsg "PvP sustain v10 loaded. Opening self TK, defensive buffs, remembered hands." 88
endif


# ========================================================================================
# MAIN LOOP
# ========================================================================================
while not dead
    # ------------------------------------------------------------------------------------
    # PASS START                                                         module/base.razor
    # ------------------------------------------------------------------------------------
    if pvp
        overhead "[ script, blocked ]" 254
        stop
    endif

    if config__settle_first = 1
        while queued or casting
            wait wait__short
        endwhile
    endif

    # ------------------------------------------------------------------------------------
    # REMEMBER HANDS                                     module/fight/remember-hands.razor
    # ------------------------------------------------------------------------------------
    if config__rearm_follow_hands = 1
        if not lhandempty or not rhandempty
            @setvar! var__rearm_seen_left 0
            @setvar! var__rearm_seen_right 0

            if findlayer self lefthand as alias__remember_left
                @setvar! var__rearm_seen_left alias__remember_left
            endif

            if findlayer self righthand as alias__remember_right
                @setvar! var__rearm_seen_right alias__remember_right
            endif

            if var__rearm_seen_left != 0 and var__rearm_left != var__rearm_seen_left
                @setvar! var__rearm_left var__rearm_seen_left
                @setvar! var__rearm_right var__rearm_seen_right

                if config__sysmsg = 1
                    sysmsg "Rearm: current hands remembered, left={{var__rearm_left}}, right={{var__rearm_right}}." 88
                endif
            elseif var__rearm_seen_right != 0 and var__rearm_right != var__rearm_seen_right
                @setvar! var__rearm_left var__rearm_seen_left
                @setvar! var__rearm_right var__rearm_seen_right

                if config__sysmsg = 1
                    sysmsg "Rearm: current hands remembered, left={{var__rearm_left}}, right={{var__rearm_right}}." 88
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # OPENING TELEKINESIS                               module/buff/self-telekinesis.razor
    # ------------------------------------------------------------------------------------
    if var__self_telekinesis_pending = 1 and config__use_magery = 1
        if cooldown "teleki, me" > 0
            @setvar! var__self_telekinesis_pending 0
        elseif not paralyzed and not hidden and not queued and not casting and not targetexists and mana >= config__mana_3rd
            if findtype 3963 self and findtype 3974 self and not queued and not casting and not targetexists
                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                    # consumed, nothing else to do
                endif

                @setvar! var__self_telekinesis_pending 0
                cast "Telekinesis"
                if config__sysmsg = 1
                    sysmsg "Opening: Telekinesis on self requested." 88
                endif
                wait wait__short

                for 60
                    if targetexists
                        break
                    endif

                    if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                        break
                    endif

                    wait wait__poll
                endfor

                if targetexists "harmful" or targetexists "neutral"
                    target self
                    wait wait__cast
                elseif targetexists
                    hotkey "Cancel Current Target"
                    wait wait__short
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # REAGENTS                                                module/magery/reagents.razor
    # ------------------------------------------------------------------------------------
    if config__use_magery = 1
        if timer "timer__reagents" >= interval__reagents or insysmsg "More reagents are needed"
            settimer "timer__reagents" 0

            @setvar! var__has_black_pearl 0
            @setvar! var__has_bloodmoss 0
            @setvar! var__has_garlic 0
            @setvar! var__has_ginseng 0
            @setvar! var__has_mandrake 0
            @setvar! var__has_nightshade 0
            @setvar! var__has_ash 0
            @setvar! var__has_silk 0

            if findtype 3962 self
                @setvar! var__has_black_pearl 1
            endif

            if findtype 3963 self
                @setvar! var__has_bloodmoss 1
            endif

            if findtype 3972 self
                @setvar! var__has_garlic 1
            endif

            if findtype 3973 self
                @setvar! var__has_ginseng 1
            endif

            if findtype 3974 self
                @setvar! var__has_mandrake 1
            endif

            if findtype 3976 self
                @setvar! var__has_nightshade 1
            endif

            if findtype 3980 self
                @setvar! var__has_ash 1
            endif

            if findtype 3981 self
                @setvar! var__has_silk 1
            endif

            @setvar! var__regs_cure 0
            @setvar! var__regs_heal 0
            @setvar! var__regs_greater_heal 0
            @setvar! var__regs_create_food 0
            @setvar! var__regs_reactive_armor 0
            @setvar! var__regs_magic_reflect 0
            @setvar! var__regs_magic_arrow 0
            @setvar! var__regs_harm 0
            @setvar! var__regs_fireball 0
            @setvar! var__regs_lightning 0
            @setvar! var__regs_curse 0
            @setvar! var__regs_mana_drain 0
            @setvar! var__regs_energy_bolt 0
            @setvar! var__regs_bless 0
            @setvar! var__regs_protection 0
            @setvar! var__regs_arch_protection 0
            @setvar! var__regs_flamestrike 0
            @setvar! var__regs_summon 0
            @setvar! var__regs_summon_ash 0

            if var__has_garlic = 1 and var__has_ginseng = 1
                @setvar! var__regs_cure 1
            endif

            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_silk = 1
                @setvar! var__regs_heal 1
            endif

            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_greater_heal 1
            endif

            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1
                @setvar! var__regs_create_food 1
            endif

            if var__has_garlic = 1 and var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_reactive_armor 1
            endif

            if var__has_garlic = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_magic_reflect 1
            endif

            if var__has_ash = 1
                @setvar! var__regs_magic_arrow 1
            endif

            if var__has_nightshade = 1 and var__has_silk = 1
                @setvar! var__regs_harm 1
            endif

            if var__has_black_pearl = 1
                @setvar! var__regs_fireball 1
            endif

            if var__has_mandrake = 1 and var__has_ash = 1
                @setvar! var__regs_lightning 1
            endif

            if var__has_garlic = 1 and var__has_nightshade = 1 and var__has_ash = 1
                @setvar! var__regs_curse 1
            endif

            if var__has_black_pearl = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_mana_drain 1
            endif

            if var__has_black_pearl = 1 and var__has_nightshade = 1
                @setvar! var__regs_energy_bolt 1
            endif

            if var__has_garlic = 1 and var__has_mandrake = 1
                @setvar! var__regs_bless 1
            endif

            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_ash = 1
                @setvar! var__regs_protection 1
            endif

            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1 and var__has_ash = 1
                @setvar! var__regs_arch_protection 1
            endif

            if var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_flamestrike 1
            endif

            if var__has_bloodmoss = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_summon 1
            endif

            if var__has_bloodmoss = 1 and var__has_mandrake = 1 and var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_summon_ash 1
            endif
        endif
    endif

    if paralyzed or poisoned or diffhits > 0
        # --------------------------------------------------------------------------------
        # CURE                                                  module/recovery/cure.razor
        # --------------------------------------------------------------------------------
        if paralyzed
            if findtype 3705 backpack 38
                yell "[Pouch"
                wait wait__short
            elseif timer "timer__message" >= interval__message
                overhead "[ pouch, out ]" 254
                settimer "timer__message" 0
            endif
        elseif poisoned and not hidden and not queued and not targetexists
            if config__use_potions = 1 and findtype "Orange Potion" self
                hotkey "Drink Cure"
                wait wait__short
            else
                if config__use_potions = 1 and timer "timer__message" >= interval__message
                    overhead "[ cure pot, out ]" 254
                    settimer "timer__message" 0
                endif

                if config__use_magery = 1 and var__regs_cure = 1 and mana >= config__mana_cure and not casting
                    if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                        if config__walk_guard = 0 or cooldown "walk" = 0
                            hotkey "> Smart Heal/Cure Self"
                            if config__sysmsg = 1
                                sysmsg "Agent: Smart Heal/Cure Self for poison." 88
                            endif
                            wait wait__short

                            for 60
                                if not casting
                                    break
                                endif

                                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                    break
                                endif

                                wait wait__poll
                            endfor
                        endif
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # HEAL                                                  module/recovery/heal.razor
        # --------------------------------------------------------------------------------
        if not poisoned and not paralyzed and not hidden and not queued and not targetexists and diffhits >= config__heal_hits
            @setvar! var__heal_potion_out 0

            if config__use_potions = 1 and cooldown "heal pot" = 0
                if findtype "Yellow Potion" self as alias__heal_potion
                    getlabel alias__heal_potion label__heal_potion

                    if "next usable" in label__heal_potion
                        # Still on its own cooldown.
                    else
                        hotkey "Drink Heal"
                        cooldown "heal pot" cooldown__heal_potion
                        @setvar! var__heal_potion_out 1
                        wait wait__short
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ heal pot, out ]" 254
                    settimer "timer__message" 0
                endif
            endif

            if var__heal_potion_out = 0 and diffhits >= config__emergency_hits and config__use_magery = 1 and var__regs_greater_heal = 1 and mana >= config__mana_greater_heal and not casting
                if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                    hotkey "> Greater Heal/Cure Self"
                    if config__sysmsg = 1
                        sysmsg "Agent: Greater Heal/Cure Self." 88
                    endif
                    wait wait__short

                    for 60
                        if not casting
                            break
                        endif

                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            break
                        endif

                        wait wait__poll
                    endfor

                    if targetexists "beneficial" and diffhits = 0
                        hotkey "Cancel Current Target"
                        wait wait__short
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # BANDAGE                                            module/recovery/bandage.razor
        # --------------------------------------------------------------------------------
        if config__use_bandages = 1 and not bandaging and not paralyzed and not hidden and not queued and not targetexists and skill "Healing" > config__heal_skill_min
            if diffhits > 0 or poisoned
                if findtype 3617 self
                    hotkey "Bandage Self"
                    wait wait__short
                elseif timer "timer__message" >= interval__message
                    overhead "[ bandage, out ]" 254
                    settimer "timer__message" 0
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # LIGHT HEAL                                      module/recovery/light-heal.razor
        # --------------------------------------------------------------------------------
        if not poisoned and not paralyzed and not hidden and not queued and not casting and not targetexists and config__use_magery = 1 and var__regs_heal = 1 and diffhits >= config__light_hits and mana >= config__mana_heal
            @setvar! var__light_heal_due 0

            if config__use_light_heal = 1 or config__use_bandages = 0 or skill "Healing" <= config__heal_skill_min
                @setvar! var__light_heal_due 1
            elseif not bandaging and not findtype 3617 self
                @setvar! var__light_heal_due 1
            endif

            if var__light_heal_due = 1
                if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                    if config__walk_guard = 0 or cooldown "walk" = 0
                        hotkey "> Smart Heal/Cure Self"
                        if config__sysmsg = 1
                            sysmsg "Agent: Smart Heal/Cure Self, light Heal." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "beneficial" and diffhits = 0
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # REFRESH                                                module/recovery/refresh.razor
    # ------------------------------------------------------------------------------------
    if stam <= config__refresh_stam and config__use_potions = 1 and not paralyzed and not hidden and not queued and not targetexists
        if findtype "Red Potion" self
            hotkey "Drink Refresh"
            wait wait__short
        endif
    endif

    # ------------------------------------------------------------------------------------
    # STAT POTIONS                                               module/buff/potions.razor
    # ------------------------------------------------------------------------------------
    if var__fighting = 1 and config__use_potions = 1 and timer "timer__potion_check" >= interval__potion_check
        if not queued and not paralyzed and not hidden and not targetexists
            settimer "timer__potion_check" 0

            if str < config__str_potion and timer "timer__str_potion" >= interval__stat_potion
                settimer "timer__str_potion" 0

                if findtype "White Potion" self
                    hotkey "Drink Strength"
                    settimer "timer__potion_check" interval__potion_check
                    wait wait__short
                endif
            endif

            if not queued and dex < config__dex_potion and timer "timer__agi_potion" >= interval__stat_potion
                settimer "timer__agi_potion" 0

                if findtype "Blue Potion" self
                    hotkey "Drink Agility"
                    settimer "timer__potion_check" interval__potion_check
                    wait wait__short
                endif
            endif

            if config__use_resist_potion = 1 and not queued and not findbuff "Magic Resist Potion"
                if findtype "Black Potion" self
                    hotkey "Drink Magic Resist"
                    settimer "timer__potion_check" interval__potion_check
                    wait wait__short
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # SELF BUFFS                                                  module/buff/spells.razor
    # ------------------------------------------------------------------------------------
    if config__use_magery = 1 and var__hold_casts = 0 and not paralyzed and not hidden and not queued and not casting and not targetexists and diffhits < config__buff_max_loss
        if config__buff_when_poisoned = 1 or not poisoned
            if config__warmode_is_manual = 0 or not warmode
                if config__walk_guard = 0 or cooldown "walk" = 0
                    if config__use_reactive_armor = 1 and var__regs_reactive_armor = 1 and mana >= config__mana_reactive_armor and not findbuff "Reactive Armor"
                        cast "Reactive Armor"
                        if config__sysmsg = 1
                            sysmsg "Buff: Reactive Armor." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor
                    elseif config__use_magic_reflect = 1 and var__regs_magic_reflect = 1 and mana >= config__mana_magic_reflect and cooldown "reflect" = 0 and not findbuff "Magic Reflection"
                        cast "Magic Reflection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Magic Reflection." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor
                    elseif config__use_protection = 1 and var__regs_protection = 1 and mana >= config__mana_protection and not findbuff "Protection"
                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            # consumed, nothing else to do
                        endif

                        cast "Protection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Protection." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if not casting
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "beneficial" or targetexists "neutral"
                            target self

                            for 10
                                if findbuff "Protection"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_bless = 1 and var__fighting = 0 and not warmode and var__regs_bless = 1 and mana >= config__mana_bless and not findbuff "Cunning"
                        cast "Bless"
                        if config__sysmsg = 1
                            sysmsg "Buff: Bless." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "beneficial"
                            target self

                            for 10
                                if findbuff "Cunning"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_arch_protection = 1 and var__fighting = 0 and not warmode and var__regs_arch_protection = 1 and mana >= config__mana_arch_protection and not findbuff "Protection"
                        cast "Arch Protection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Arch Protection." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "neutral"
                            target self

                            for 10
                                if findbuff "Protection"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_spell_siphon = 1 and not warmode and var__regs_magic_arrow = 1 and mana >= config__mana_spell_siphon and not findbuff "Spell Siphon" and not findbuff "Magic Reflection"
                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            # consumed, nothing else to do
                        endif

                        cast "Magic Arrow"
                        if config__sysmsg = 1
                            sysmsg "Buff: Magic Arrow on yourself for Spell Siphon." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "harmful"
                            hotkey 'Target Self'
                            wait wait__cast
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # REARM                                                       module/fight/rearm.razor
    # ------------------------------------------------------------------------------------
    @setvar! var__rearm_due 0

    if timer "timer__equip" >= interval__equip_retry
        @setvar! var__rearm_due 1
    elseif var__rearm_left != 0 and lhandempty
        @setvar! var__rearm_due 1
    elseif var__rearm_right != 0 and rhandempty
        @setvar! var__rearm_due 1
    endif

    if var__rearm_due = 1
        if not hidden and not queued and not casting and not targetexists
            settimer "timer__equip" 0
            @setvar! var__rearm_sent 0
            @setvar! var__rearm_seen_left 0
            @setvar! var__rearm_seen_right 0

            if findlayer self lefthand as alias__rearm_left
                @setvar! var__rearm_seen_left alias__rearm_left
            endif

            if findlayer self righthand as alias__rearm_right
                @setvar! var__rearm_seen_right alias__rearm_right
            endif

            if config__rearm_follow_hands = 1
                if var__rearm_seen_left != 0 and var__rearm_seen_left != var__rearm_left
                    @setvar! var__rearm_left 0
                    @setvar! var__rearm_right 0
                elseif var__rearm_seen_right != 0 and var__rearm_seen_right != var__rearm_right
                    @setvar! var__rearm_left 0
                    @setvar! var__rearm_right 0
                endif
            endif

            if var__rearm_seen_left != 0
                @setvar! var__rearm_pending 0

                if var__rearm_left != var__rearm_seen_left
                    @setvar! var__rearm_left var__rearm_seen_left

                    if config__sysmsg = 1
                        sysmsg "Rearm: two-handed layer remembered, serial={{var__rearm_left}}." 88
                    endif
                endif
            endif

            if var__rearm_seen_right != 0
                @setvar! var__rearm_pending 0

                if var__rearm_right != var__rearm_seen_right
                    @setvar! var__rearm_right var__rearm_seen_right

                    if config__sysmsg = 1
                        sysmsg "Rearm: one-handed layer remembered, serial={{var__rearm_right}}." 88
                    endif
                endif
            endif

            if var__rearm_seen_left = 0 and var__rearm_left != 0 and timer "timer__equip_sent" >= interval__equip_retry
                if find var__rearm_left backpack as alias__rearm_packed
                    if not hidden and not queued and not casting and not targetexists
                        lift alias__rearm_packed
                        drop self lefthand
                        @setvar! var__rearm_sent 1
                        settimer "timer__equip_sent" 0

                        if config__sysmsg = 1
                            sysmsg "Rearm: equip requested on the two-handed layer, serial={{alias__rearm_packed}}. The next check reads the hands." 88
                        endif

                        wait wait__short
                    endif
                else
                    @setvar! var__rearm_left 0
                endif
            endif

            if var__rearm_sent = 0 and var__rearm_seen_right = 0 and var__rearm_right != 0 and timer "timer__equip_sent" >= interval__equip_retry
                if find var__rearm_right backpack as alias__rearm_packed
                    if not hidden and not queued and not casting and not targetexists
                        lift alias__rearm_packed
                        drop self righthand
                        @setvar! var__rearm_sent 1
                        settimer "timer__equip_sent" 0

                        if config__sysmsg = 1
                            sysmsg "Rearm: equip requested on the one-handed layer, serial={{alias__rearm_packed}}. The next check reads the hands." 88
                        endif

                        wait wait__short
                    endif
                else
                    @setvar! var__rearm_right 0
                endif
            endif

            if var__rearm_sent = 0 and config__rearm_graphic != 0 and var__rearm_left = 0 and var__rearm_right = 0 and lhandempty and rhandempty and timer "timer__equip_sent" >= interval__equip_retry
                if not find var__rearm_pending backpack
                    @setvar! var__rearm_pending 0

                    if findtype config__rearm_graphic backpack as alias__rearm_pick
                        @setvar! var__rearm_pending alias__rearm_pick
                    endif
                endif

                if find var__rearm_pending backpack as alias__rearm_found
                    if not hidden and not queued and not casting and not targetexists
                        lift alias__rearm_found
                        drop self lefthand
                        settimer "timer__equip_sent" 0

                        if config__sysmsg = 1
                            sysmsg "Rearm: graphic {{config__rearm_graphic}} picked from the backpack, serial={{alias__rearm_found}}. The next check reads the hands." 88
                        endif

                        wait wait__short
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ weapon, out ]" 254
                    settimer "timer__message" 0
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # END OF PASS                                                        module/base.razor
    # ------------------------------------------------------------------------------------
    wait wait__poll
endwhile
