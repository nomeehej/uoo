# Clear targets and drag state, including a held item's backpack recovery request.
# Never wait indefinitely or bypass the registered hunting loop after a handled failure.
clearall
@gumpclose 949095101
@clearignore

if listexists 'list__resume_script'
    foreach resume_hotkey in list__resume_script
        hotkey resume_hotkey
    endfor
endif
