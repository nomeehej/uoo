# Identify loot in the loot bag, recycle low grades, and move kept items to the supply pouch.
# Two passes: single item ID wands on every unidentified piece, then one label read each.
# Needs: a loot bag, a supply pouch, single item ID wands (20496), and a recycling tool.
# Based on "Item Recycle while Farming" by Jaseowns (outlands.uorazorscripts.com), 6/01/2026.
# Containers use global__my_loot_bag and global__my_supply_pouch, or unique backpack matches.
# Kept items go to the supply pouch at 130 200.
# Normal completion and handled failures return through list__resume_script.

clearall
clearsysmsg
cleardragdrop
clearignore

# ========================================================================================
# CONFIG
# ========================================================================================
# Optional overheads. Warnings always show.
@setvar! config__chatty 1
# Journal lines for every item checked and saved.
@setvar! config__sysmsg 0

# Plain resources dropped at your feet at the end.
@setvar! config__drop_ingots 1
@setvar! config__drop_boards 1
@setvar! config__drop_leather 1
@setvar! config__drop_scrolls 1

# Drink an arcane essence at the end.
@setvar! config__drink_arcane_essence 1

# Weapon accuracy kept.
@setvar! config__save_supremely 1
@setvar! config__save_exceedingly 0
@setvar! config__save_eminently 0
@setvar! config__save_surpassingly 0
@setvar! config__save_accurate 0

# Weapon damage kept.
@setvar! config__save_vanquishing 1
@setvar! config__save_power 1
@setvar! config__save_force 0
@setvar! config__save_might 0
@setvar! config__save_ruin 0

# Slayers kept. Instruments read enticement in place of slaying.
@setvar! config__save_regular_slaying 1
@setvar! config__save_greater_slaying 1
@setvar! config__save_lesser_slaying 1

# Armor protection kept, per armor type.
@setvar! config__save_invulnerability_leather 1
@setvar! config__save_fortification_leather 0
@setvar! config__save_hardening_leather 0
@setvar! config__save_guarding_leather 0
@setvar! config__save_defense_leather 0

@setvar! config__save_invulnerability_studded_leather 1
@setvar! config__save_fortification_studded_leather 0
@setvar! config__save_hardening_studded_leather 0
@setvar! config__save_guarding_studded_leather 0
@setvar! config__save_defense_studded_leather 0

@setvar! config__save_invulnerability_bone_armor 1
@setvar! config__save_fortification_bone_armor 0
@setvar! config__save_hardening_bone_armor 0
@setvar! config__save_guarding_bone_armor 0
@setvar! config__save_defense_bone_armor 0

@setvar! config__save_invulnerability_platemail 1
@setvar! config__save_fortification_platemail 0
@setvar! config__save_hardening_platemail 0
@setvar! config__save_guarding_platemail 0
@setvar! config__save_defense_platemail 0

@setvar! config__save_invulnerability_chainmail 1
@setvar! config__save_fortification_chainmail 0
@setvar! config__save_hardening_chainmail 0
@setvar! config__save_guarding_chainmail 0
@setvar! config__save_defense_chainmail 0

@setvar! config__save_invulnerability_ringmail 0
@setvar! config__save_fortification_ringmail 0
@setvar! config__save_hardening_ringmail 0
@setvar! config__save_guarding_ringmail 0
@setvar! config__save_defense_ringmail 0

# Shields, and any armor the lists above missed.
@setvar! config__save_invulnerability 1
@setvar! config__save_fortification 0
@setvar! config__save_hardening 0
@setvar! config__save_guarding 0
@setvar! config__save_defense 0

# Exceptional crafted items are kept, never recycled.
@setvar! config__save_exceptional 1

# ========================================================================================
# WAIT AND COOLDOWN
# ========================================================================================
# Fixed pauses apply only to the existing resource drops below.
@setvar! wait__drop 650
@setvar! wait__target 500
@setvar! wait__poll 50
@setvar! wait__timeout 5000

# ========================================================================================
# TIMER
# ========================================================================================
if not timerexists "timer__recycle"
    createtimer "timer__recycle"
endif

settimer "timer__recycle" 0

# ========================================================================================
# STATE
# ========================================================================================
@setvar! var__loot_bag 0
@setvar! var__supply_pouch 0
@setvar! var__id_wand 0
@setvar! var__id_wand_out 0
@setvar! var__tool 0
@setvar! var__running 1
@setvar! var__item_pending 0
@setvar! var__unidentified_left 0
@setvar! var__keep 0
@setvar! var__kind 0
@setvar! var__slayer 0
@setvar! var__armor_type 0

# ========================================================================================
# CONTAINERS
# ========================================================================================
# Saved roles first. Only a unique bag or plain pouch may substitute for a missing role.
# Never expand the equipment scan or its save destination to the whole backpack.
if varexist global__my_loot_bag and find global__my_loot_bag backpack
    @setvar! var__loot_bag global__my_loot_bag
elseif counttype 3702 backpack = 1 and findtype 3702 backpack as alias__loot_bag
    @setvar! var__loot_bag alias__loot_bag
endif

if varexist global__my_supply_pouch and find global__my_supply_pouch backpack
    @setvar! var__supply_pouch global__my_supply_pouch
elseif counttype 3705 backpack 0 = 1 and findtype 3705 backpack 0 as alias__supply_pouch
    @setvar! var__supply_pouch alias__supply_pouch
endif

if var__loot_bag = 0
    @setvar! var__running 0
    overhead "[ loot bag, out ]" 254
    sysmsg "Recycle: register a loot bag with loadout, or carry exactly one bag." 88
elseif var__supply_pouch = 0
    @setvar! var__running 0
    overhead "[ supplies, out ]" 254
    sysmsg "Recycle: register a supply pouch with loadout, or carry exactly one plain pouch." 88
elseif var__loot_bag = var__supply_pouch or find var__loot_bag var__supply_pouch or find var__supply_pouch var__loot_bag
    @setvar! var__running 0
    overhead "[ loot bag, wrong ]" 254
    sysmsg "Recycle: use two separate containers, with neither inside the other." 88
endif

if var__running = 1
    # Open both once. Moving a container may have hidden its contents from the client.
    dclick var__loot_bag
    dclick var__supply_pouch
    settimer "timer__recycle" 0

    while queued and timer "timer__recycle" < wait__timeout
        wait wait__poll
    endwhile

    if queued
        @setvar! var__running 0
        overhead "[ loot bag, blocked ]" 254
        sysmsg "Recycle: container queue timeout. Returning to the loop." 88
    endif
endif

# ========================================================================================
# TOOLS
# ========================================================================================
if var__running = 1
    if findtype 20496 backpack as alias__id_wand
        @setvar! var__id_wand alias__id_wand
    elseif findtype 20495 backpack
        @setvar! var__running 0
        overhead "[ id wand, wrong ]" 254
        sysmsg "Recycle: use a single item ID wand (20496)." 88
    else
        @setvar! var__running 0
        overhead "[ id wand, out ]" 254
        sysmsg "Recycle: no single item ID wand (20496)." 88
    endif
endif

if var__running = 1
    if findtype 4032|3997|7864|4148|4136 backpack as alias__tool
        @setvar! var__tool alias__tool
    else
        @setvar! var__running 0
        overhead "[ recycle tool, out ]" 254
        sysmsg "Recycle: no tinker tool, sewing kit or saw." 88
    endif
endif

# ========================================================================================
# TYPES
# ========================================================================================
# Graphic IDs identify item types, not individual item serials. Both passes walk this list.
if var__running = 1
    # Names and ID mappings: content/public/game/item-list.md, parts 2 and 29.
    removelist list__recycle_types
    createlist list__recycle_types

    # 0: Arcane staffs.
    pushlist list__recycle_types "31017|31019|31021|31023|31025|31027|31029|31031|31033|31035|31037|31038|31041|31043|31045|31047|31049|31051|31053|31055"

    # 1: Dual wielding.
    # Existing name aliases and IDs retained together for this family.
    pushlist list__recycle_types "dual wield tracker knife|duel wield katana|dual wield norse axe|dual wield rapier|dual wield sabre|dual wield scimitar|67773|67774|67775|67776|67777|67778"

    # 2: Throwing.
    # Existing name aliases and IDs retained together for this family.
    pushlist list__recycle_types "chakram|francisca|hurlbat|javelin|throwing knife|throwing star|67713|67723|67734|67744|67754|67764"

    # 3: Swordsmanship.
    pushlist list__recycle_types "3909|3911|3913|3915|3917|3934|3937|5046|5049|5115|5119|5182|5185|5187|30988|31128|31190"

    # 4: Macing.
    pushlist list__recycle_types "3568|3713|3721|3932|5040|5044|5112|5127|5177|5179|5181|30991|30999|31000|31001|31014|31178|31180|31182"

    # 5: Fencing.
    pushlist list__recycle_types "31172|31169|3719|3922|3938|5121|5123|5125|30989|30992|30996|30997|30998|31176|31188"

    # 6: Archery.
    pushlist list__recycle_types "3920|5042|5117|30990|30993|30994|30995|31184|31186"

    # 7: Shields.
    pushlist list__recycle_types "7026|7027|7029|7031|7033|7034|7035|7107|7109|31002|31130"

    # 8: Magery: wands and spellbooks.
    pushlist list__recycle_types "3570|3571|3572|3573|3834"

    # 9: Wrestling: caesti, fistblade and martial manual.
    pushlist list__recycle_types "22187|31141|31142"

    # 10: Instruments.
    pushlist list__recycle_types "3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016"

    # 11: Armor: quality uses label material, not graphic orientation.
    pushlist list__recycle_types "5051|5054|5055|5056|5059|5060|5061|5062|5063|5067|5068|5069|5070|5074|5075|5076|5077|5078|5082|5083|5084|5085|5089|5090|5099|5100|5101|5102|5103|5104|5105|5106|5129|5131|5132|5135|5136|5137|5138|5139|5140|5141|5142|5143|5144|5146|5198|5199|5200|5201|5202|5203|5204|5205|5206|5207|7168|7169|7170|7171|7172|7173|7174|7175|7176|7177|7178|7179|7180|7181|7609|7610|7947|31003|31004|31005|31006|31007|31008|31009|31010|31011|31012|31015|31174|31191"
endif

# ========================================================================================
# IDENTIFY
# ========================================================================================
# First pass: every unidentified piece of equipment gets the wand, one after the other, with
# no label re-read. The action queue paces the wand double-clicks (profile ObjectDelay), and
# the next item's label read runs inside that pause. The quality is read once in SORT, where
# an item still unidentified is left for the next run.
if var__running = 1
    # The working dagger and plain spellbook stay in the loot bag.
    while findtype 3834|3922 var__loot_bag 0 as alias__plain_item
        @ignore alias__plain_item
    endwhile

    foreach item_types in list__recycle_types
        while var__running = 1 and var__id_wand_out = 0 and findtype item_types var__loot_bag as alias__item
            # Reset the scoped reply and a numeric fallback, never reuse an old label.
            @unsetvar! label__item
            @setvar! label__item 0
            getlabel alias__item label__item

            if "unidentified" in label__item
                @setvar! var__item_pending 1

                while var__item_pending = 1
                    if var__id_wand = 0 and findtype 20496 backpack as alias__spare_wand
                        @setvar! var__id_wand alias__spare_wand
                    endif

                    if var__id_wand = 0
                        @setvar! var__item_pending 0
                        @setvar! var__id_wand_out 1
                        overhead "[ id wand, out ]" 254
                        sysmsg "Recycle: no usable ID wand. Unidentified loot left untouched." 88
                    else
                        # A busy action queue is not a spent wand.
                        settimer "timer__recycle" 0

                        while queued and timer "timer__recycle" < wait__timeout
                            wait wait__poll
                        endwhile

                        if queued
                            @setvar! var__running 0
                            @setvar! var__item_pending 0
                            overhead "[ recycle, blocked ]" 254
                            sysmsg "Recycle: action queue timeout. Returning to the loop." 88
                        else
                            hotkey 'Cancel Current Target'
                            dclick var__id_wand
                            waitfortarget wait__target

                            if targetexists
                                @setvar! var__item_pending 0

                                if find alias__item var__loot_bag
                                    target alias__item
                                else
                                    hotkey 'Cancel Current Target'
                                endif
                            else
                                # No cursor is a spent wand. The same item retries with a spare.
                                hotkey 'Cancel Current Target'
                                @ignore var__id_wand
                                @setvar! var__id_wand 0
                            endif
                        endif
                    endif
                endwhile
            endif

            @ignore alias__item
        endwhile
    endfor

    # The spent wands and the items ignored above come back for the second pass.
    @clearignore
endif

# ========================================================================================
# SORT
# ========================================================================================
# Second pass: one label read per item. Kept items move to the supply pouch, the rest are
# recycled one at a time. An item still unidentified, after a spent wand or a wand use that
# did not land, stays in the loot bag for the next run and is reported once at the end.
if var__running = 1
    while findtype 3834|3922 var__loot_bag 0 as alias__plain_item
        @ignore alias__plain_item
    endwhile

    # Quality rules: 0 weapons, 1 macing, 2 instruments, 3 shields, 4 armor.
    foreach item_types in list__recycle_types
        @setvar! var__kind 0

        if index = 4
            @setvar! var__kind 1
        elseif index = 10
            @setvar! var__kind 2
        elseif index = 7
            @setvar! var__kind 3
        elseif index = 11
            @setvar! var__kind 4
        endif

        while var__running = 1 and findtype item_types var__loot_bag as alias__item
            @unsetvar! label__item
            @setvar! label__item 0
            getlabel alias__item label__item

            if not find alias__item var__loot_bag
                # Gone since the search. Nothing to do.
            elseif label__item = 0
                overhead "[ item, skip ]" 254
                sysmsg "Recycle: no label. Item left untouched." 88
            elseif "unidentified" in label__item
                @setvar! var__unidentified_left 1

                if config__sysmsg = 1
                    sysmsg "Recycle: still unidentified. Item left untouched." 88
                endif
            else
                if config__sysmsg = 1
                    sysmsg "Recycle check: {{label__item}}" 88
                endif

                @setvar! var__keep 0
                if "aspect" in label__item
                    @setvar! var__keep 1
                elseif config__save_exceptional = 1 and "exceptional" in label__item
                    @setvar! var__keep 1
                elseif var__kind = 3
                    if config__save_invulnerability = 1 and "invulnerability" in label__item
                        @setvar! var__keep 1
                    elseif config__save_fortification = 1 and "fortification" in label__item
                        @setvar! var__keep 1
                    elseif config__save_hardening = 1 and "hardening" in label__item
                        @setvar! var__keep 1
                    elseif config__save_guarding = 1 and "guarding" in label__item
                        @setvar! var__keep 1
                    elseif config__save_defense = 1 and "defense" in label__item
                        @setvar! var__keep 1
                    endif
                elseif var__kind = 4
                    @setvar! var__armor_type 0
                    if "plate" in label__item
                        @setvar! var__armor_type 6
                    elseif "chain" in label__item
                        @setvar! var__armor_type 5
                    elseif "ring" in label__item
                        @setvar! var__armor_type 4
                    elseif "bone" in label__item
                        @setvar! var__armor_type 3
                    elseif "studded" in label__item
                        @setvar! var__armor_type 2
                    elseif "leather" in label__item
                        @setvar! var__armor_type 1
                    elseif "bascinet" in label__item or "close helm" in label__item or "norse helm" in label__item
                        @setvar! var__armor_type 6
                    elseif "orc helm" in label__item
                        @setvar! var__armor_type 4
                    endif

                    if var__armor_type = 1
                        if config__save_invulnerability_leather = 1 and "invulnerability" in label__item
                            @setvar! var__keep 1
                        elseif config__save_fortification_leather = 1 and "fortification" in label__item
                            @setvar! var__keep 1
                        elseif config__save_hardening_leather = 1 and "hardening" in label__item
                            @setvar! var__keep 1
                        elseif config__save_guarding_leather = 1 and "guarding" in label__item
                            @setvar! var__keep 1
                        elseif config__save_defense_leather = 1 and "defense" in label__item
                            @setvar! var__keep 1
                        endif
                    elseif var__armor_type = 2
                        if config__save_invulnerability_studded_leather = 1 and "invulnerability" in label__item
                            @setvar! var__keep 1
                        elseif config__save_fortification_studded_leather = 1 and "fortification" in label__item
                            @setvar! var__keep 1
                        elseif config__save_hardening_studded_leather = 1 and "hardening" in label__item
                            @setvar! var__keep 1
                        elseif config__save_guarding_studded_leather = 1 and "guarding" in label__item
                            @setvar! var__keep 1
                        elseif config__save_defense_studded_leather = 1 and "defense" in label__item
                            @setvar! var__keep 1
                        endif
                    elseif var__armor_type = 3
                        if config__save_invulnerability_bone_armor = 1 and "invulnerability" in label__item
                            @setvar! var__keep 1
                        elseif config__save_fortification_bone_armor = 1 and "fortification" in label__item
                            @setvar! var__keep 1
                        elseif config__save_hardening_bone_armor = 1 and "hardening" in label__item
                            @setvar! var__keep 1
                        elseif config__save_guarding_bone_armor = 1 and "guarding" in label__item
                            @setvar! var__keep 1
                        elseif config__save_defense_bone_armor = 1 and "defense" in label__item
                            @setvar! var__keep 1
                        endif
                    elseif var__armor_type = 4
                        if config__save_invulnerability_ringmail = 1 and "invulnerability" in label__item
                            @setvar! var__keep 1
                        elseif config__save_fortification_ringmail = 1 and "fortification" in label__item
                            @setvar! var__keep 1
                        elseif config__save_hardening_ringmail = 1 and "hardening" in label__item
                            @setvar! var__keep 1
                        elseif config__save_guarding_ringmail = 1 and "guarding" in label__item
                            @setvar! var__keep 1
                        elseif config__save_defense_ringmail = 1 and "defense" in label__item
                            @setvar! var__keep 1
                        endif
                    elseif var__armor_type = 5
                        if config__save_invulnerability_chainmail = 1 and "invulnerability" in label__item
                            @setvar! var__keep 1
                        elseif config__save_fortification_chainmail = 1 and "fortification" in label__item
                            @setvar! var__keep 1
                        elseif config__save_hardening_chainmail = 1 and "hardening" in label__item
                            @setvar! var__keep 1
                        elseif config__save_guarding_chainmail = 1 and "guarding" in label__item
                            @setvar! var__keep 1
                        elseif config__save_defense_chainmail = 1 and "defense" in label__item
                            @setvar! var__keep 1
                        endif
                    elseif var__armor_type = 6
                        if config__save_invulnerability_platemail = 1 and "invulnerability" in label__item
                            @setvar! var__keep 1
                        elseif config__save_fortification_platemail = 1 and "fortification" in label__item
                            @setvar! var__keep 1
                        elseif config__save_hardening_platemail = 1 and "hardening" in label__item
                            @setvar! var__keep 1
                        elseif config__save_guarding_platemail = 1 and "guarding" in label__item
                            @setvar! var__keep 1
                        elseif config__save_defense_platemail = 1 and "defense" in label__item
                            @setvar! var__keep 1
                        endif
                    else
                        if config__save_invulnerability = 1 and "invulnerability" in label__item
                            @setvar! var__keep 1
                        elseif config__save_fortification = 1 and "fortification" in label__item
                            @setvar! var__keep 1
                        elseif config__save_hardening = 1 and "hardening" in label__item
                            @setvar! var__keep 1
                        elseif config__save_guarding = 1 and "guarding" in label__item
                            @setvar! var__keep 1
                        elseif config__save_defense = 1 and "defense" in label__item
                            @setvar! var__keep 1
                        endif
                    endif
                else
                    @setvar! var__slayer 0
                    if var__kind = 2
                        if "enticement" in label__item
                            @setvar! var__slayer 1
                        endif
                    elseif "slaying" in label__item
                        @setvar! var__slayer 1
                    endif

                    if config__save_greater_slaying = 1 and var__slayer = 1 and "greater" in label__item
                        @setvar! var__keep 1
                    elseif config__save_lesser_slaying = 1 and var__slayer = 1 and "lesser" in label__item
                        @setvar! var__keep 1
                    elseif config__save_supremely = 1 and "supremely" in label__item
                        @setvar! var__keep 1
                    elseif config__save_exceedingly = 1 and "exceedingly" in label__item
                        @setvar! var__keep 1
                    elseif config__save_eminently = 1 and "eminently" in label__item
                        @setvar! var__keep 1
                    elseif config__save_surpassingly = 1 and "surpassingly" in label__item
                        @setvar! var__keep 1
                    elseif config__save_accurate = 1 and "accurate" in label__item
                        @setvar! var__keep 1
                    elseif config__save_vanquishing = 1 and "vanquishing" in label__item
                        @setvar! var__keep 1
                    elseif config__save_power = 1 and "power" in label__item
                        @setvar! var__keep 1
                    elseif config__save_force = 1 and "force" in label__item
                        @setvar! var__keep 1
                    elseif config__save_might = 1 and "might" in label__item
                        @setvar! var__keep 1
                    elseif config__save_ruin = 1 and var__kind != 1 and "ruin" in label__item
                        @setvar! var__keep 1
                    elseif config__save_regular_slaying = 1 and var__slayer = 1
                        if "lesser" in label__item
                            # A lesser one follows config__save_lesser_slaying above.
                        else
                            @setvar! var__keep 1
                        endif
                    endif
                endif

                if var__keep = 1
                    if find alias__item var__loot_bag
                        if config__chatty = 1
                            overhead "[ item, saving ]" 290
                        endif
                        if config__sysmsg = 1
                            sysmsg "Recycle save: {{label__item}}" 88
                        endif

                        lift alias__item
                        drop var__supply_pouch 130 200 0
                        settimer "timer__recycle" 0

                        while not find alias__item var__supply_pouch and timer "timer__recycle" < wait__timeout
                            wait wait__poll
                        endwhile

                        if not find alias__item var__supply_pouch
                            @setvar! var__running 0
                            overhead "[ supplies, blocked ]" 254
                            sysmsg "Recycle: move not confirmed. Remaining loot left for the next run." 88
                        endif
                    endif
                else
                    if not gumpexists 949095101
                        if not find var__tool backpack
                            @setvar! var__tool 0
                            if findtype 4032|3997|7864|4148|4136 backpack as alias__spare_tool
                                @setvar! var__tool alias__spare_tool
                            endif
                        endif

                        if var__tool != 0
                            dclick var__tool
                            waitforgump 949095101 wait__timeout
                        endif
                    endif

                    if gumpexists 949095101
                        if ingump "Recycle Single Item" 949095101
                            hotkey 'Cancel Current Target'
                            gumpresponse 3 949095101
                            waitfortarget wait__target

                            if targetexists
                                if find alias__item var__loot_bag
                                    target alias__item
                                    settimer "timer__recycle" 0

                                    while find alias__item var__loot_bag and timer "timer__recycle" < wait__timeout
                                        wait wait__poll
                                    endwhile

                                    if find alias__item var__loot_bag
                                        @setvar! var__running 0
                                        overhead "[ recycle, blocked ]" 254
                                        sysmsg "Recycle: item removal not confirmed. Remaining loot left for the next run." 88
                                    endif
                                else
                                    hotkey 'Cancel Current Target'
                                endif
                            else
                                @setvar! var__running 0
                                hotkey 'Cancel Current Target'
                                overhead "[ recycle, blocked ]" 254
                                sysmsg "Recycle: no recycling cursor. Remaining loot left untouched." 88
                            endif
                        else
                            @setvar! var__running 0
                            overhead "[ recycle, wrong ]" 254
                            sysmsg "Recycle: select Recycle Single Item in the tool menu." 88
                        endif
                    else
                        @setvar! var__running 0
                        overhead "[ recycle, blocked ]" 254
                        sysmsg "Recycle: no recycling menu. Remaining loot left untouched." 88
                    endif
                endif
            endif

            @ignore alias__item
        endwhile
    endfor

    if var__unidentified_left = 1
        overhead "[ unidentified, skip ]" 254
        sysmsg "Recycle: unidentified loot left in the bag for the next run." 88
    endif
endif

# ========================================================================================
# DROPS
# ========================================================================================
# An arcane essence first, then plain ingots, boards, leather and scrolls at your feet.
# Failed equipment processing skips drops and returns without more item actions.
if var__running = 1
    if config__drink_arcane_essence = 1 and findtype 3901 backpack as alias__item
        dclick alias__item
        waitfortarget wait__target
        target self
    endif

    if config__drop_ingots = 1 and findtype 7154 backpack as alias__drop_item
        clearsysmsg
        lift alias__drop_item 60000
        droprelloc 0 0
        wait wait__drop

        if insysmsg "cannot drop anything"
            drop backpack -1 -1 -1
        endif
    endif

    if config__drop_boards = 1 and findtype 7127 backpack 0 as alias__drop_item
        clearsysmsg
        lift alias__drop_item 60000
        droprelloc 0 0
        wait wait__drop

        if insysmsg "cannot drop anything"
            drop backpack -1 -1 -1
        endif
    endif

    if config__drop_leather = 1 and findtype 4225 backpack 0 as alias__drop_item
        clearsysmsg
        lift alias__drop_item 60000
        droprelloc 0 0
        wait wait__drop

        if insysmsg "cannot drop anything"
            drop backpack -1 -1 -1
        endif
    endif

    if config__drop_scrolls = 1 and findtype 3827 backpack 0 as alias__drop_item
        clearsysmsg
        lift alias__drop_item 60000
        droprelloc 0 0
        wait wait__drop

        if insysmsg "cannot drop anything"
            drop backpack -1 -1 -1
        endif
    endif

    settimer "timer__recycle" 0

    while queued and timer "timer__recycle" < wait__timeout
        wait wait__poll
    endwhile

    if queued
        @setvar! var__running 0
        overhead "[ recycle, blocked ]" 254
        sysmsg "Recycle: drop queue timeout. Returning to the loop." 88
    endif
endif

