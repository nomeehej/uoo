    overhead "[ skinning, on ]" 290
endif


# ========================================================================================
# MAIN LOOP
# ========================================================================================
while not dead
    # ------------------------------------------------------------------------------------
    # PASS START                                                         module/base.razor
    # ------------------------------------------------------------------------------------
    if pvp
        overhead "[ script, blocked ]" 254
        stop
    endif

    if config__settle_first = 1
        while queued or casting
            wait wait__short
        endwhile
    endif

    # ------------------------------------------------------------------------------------
    # COMBAT TARGET                                              module/fight/target.razor
    # ------------------------------------------------------------------------------------
    if find lastharmful ground -1 -1 config__acquire_range as alias__fresh_target
        if var__target_hold != 0 and alias__fresh_target != var__target_hold
            @setvar! var__target_hold 0
        endif

        if var__combat_target = alias__fresh_target or var__target_hold = alias__fresh_target
            # Already the enemy, or the block target held above.
        else
            @setvar! var__fresh_serial alias__fresh_target

            if 0x40000000 > var__fresh_serial
                if not dead alias__fresh_target
                    if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                        @setvar! var__combat_target alias__fresh_target
                        settimer "timer__target_grace" 0
                        if config__chatty = 1
                            overhead "[ target, set ]" 1288 var__combat_target
                        endif
                        if config__sysmsg = 1
                            sysmsg "Combat target: {{alias__fresh_target}}." 88
                        endif
                    endif
                endif
            endif
        endif
    endif

    @setvar! var__fighting 0

    if var__combat_target = 0
        # No enemy remembered, nothing to keep.
    elseif find var__combat_target ground -1 -1 config__target_range as alias__stored_target
        settimer "timer__target_grace" 0

        if dead alias__stored_target
            @setvar! var__combat_target 0
            @setvar! var__target_hold 0
        elseif noto alias__stored_target != "hostile" and noto alias__stored_target != "criminal" and noto alias__stored_target != "enemy" and noto alias__stored_target != "murderer"
            @setvar! var__combat_target 0
            @setvar! var__target_hold 0
        else
            @setvar! var__fighting 1
        endif
    elseif find var__combat_target ground -1 -1 config__acquire_range as alias__stored_target
        settimer "timer__target_grace" 0

        if dead alias__stored_target
            @setvar! var__combat_target 0
            @setvar! var__target_hold 0
        endif
    elseif timer "timer__target_grace" >= config__target_grace
        @setvar! var__combat_target 0
        @setvar! var__target_hold 0
    endif

    if paralyzed or poisoned or diffhits > 0
        # --------------------------------------------------------------------------------
        # CURE                                                  module/recovery/cure.razor
        # --------------------------------------------------------------------------------
        if paralyzed
            if findtype 3705 backpack 38
                yell "[Pouch"
                wait wait__short
            elseif timer "timer__message" >= interval__message
                overhead "[ pouch, out ]" 254
                settimer "timer__message" 0
            endif
        elseif poisoned and not hidden and not queued and not targetexists
            if config__use_potions = 1 and findtype "Orange Potion" self
                hotkey "Drink Cure"
                wait wait__short
            else
                if config__use_potions = 1 and timer "timer__message" >= interval__message
                    overhead "[ cure pot, out ]" 254
                    settimer "timer__message" 0
                endif

                if config__use_magery = 1 and var__regs_cure = 1 and mana >= config__mana_cure and not casting
                    if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                        if config__walk_guard = 0 or cooldown "walk" = 0
                            hotkey "> Smart Heal/Cure Self"
                            if config__sysmsg = 1
                                sysmsg "Agent: Smart Heal/Cure Self for poison." 88
                            endif
                            wait wait__short

                            for 60
                                if not casting
                                    break
                                endif

                                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                    break
                                endif

                                wait wait__poll
                            endfor
                        endif
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # HEAL                                                  module/recovery/heal.razor
        # --------------------------------------------------------------------------------
        if not poisoned and not paralyzed and not hidden and not queued and not targetexists and diffhits >= config__heal_hits
            @setvar! var__heal_potion_out 0

            if config__use_potions = 1 and cooldown "heal pot" = 0
                if findtype "Yellow Potion" self as alias__heal_potion
                    getlabel alias__heal_potion label__heal_potion

                    if "next usable" in label__heal_potion
                        # Still on its own cooldown.
                    else
                        hotkey "Drink Heal"
                        cooldown "heal pot" cooldown__heal_potion
                        @setvar! var__heal_potion_out 1
                        wait wait__short
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ heal pot, out ]" 254
                    settimer "timer__message" 0
                endif
            endif

            if var__heal_potion_out = 0 and diffhits >= config__emergency_hits and config__use_magery = 1 and var__regs_greater_heal = 1 and mana >= config__mana_greater_heal and not casting
                if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                    hotkey "> Greater Heal/Cure Self"
                    if config__sysmsg = 1
                        sysmsg "Agent: Greater Heal/Cure Self." 88
                    endif
                    wait wait__short

                    for 60
                        if not casting
                            break
                        endif

                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            break
                        endif

                        wait wait__poll
                    endfor

                    if targetexists "beneficial" and diffhits = 0
                        hotkey "Cancel Current Target"
                        wait wait__short
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # BANDAGE                                            module/recovery/bandage.razor
        # --------------------------------------------------------------------------------
        if config__use_bandages = 1 and not bandaging and not paralyzed and not hidden and not queued and not targetexists and skill "Healing" > config__heal_skill_min
            if diffhits > 0 or poisoned
                if findtype 3617 self
                    hotkey "Bandage Self"
                    wait wait__short
                elseif timer "timer__message" >= interval__message
                    overhead "[ bandage, out ]" 254
                    settimer "timer__message" 0
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # LIGHT HEAL                                      module/recovery/light-heal.razor
        # --------------------------------------------------------------------------------
        if not poisoned and not paralyzed and not hidden and not queued and not casting and not targetexists and config__use_magery = 1 and var__regs_heal = 1 and diffhits >= config__light_hits and mana >= config__mana_heal
            @setvar! var__light_heal_due 0

            if config__use_light_heal = 1 or config__use_bandages = 0 or skill "Healing" <= config__heal_skill_min
                @setvar! var__light_heal_due 1
            elseif not bandaging and not findtype 3617 self
                @setvar! var__light_heal_due 1
            endif

            if var__light_heal_due = 1
                if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                    if config__walk_guard = 0 or cooldown "walk" = 0
                        hotkey "> Smart Heal/Cure Self"
                        if config__sysmsg = 1
                            sysmsg "Agent: Smart Heal/Cure Self, light Heal." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "beneficial" and diffhits = 0
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # REFRESH                                                module/recovery/refresh.razor
    # ------------------------------------------------------------------------------------
    if stam <= config__refresh_stam and config__use_potions = 1 and not paralyzed and not hidden and not queued and not targetexists
        if findtype "Red Potion" self
            hotkey "Drink Refresh"
            wait wait__short
        endif
    endif

    # ------------------------------------------------------------------------------------
    # REARM                                                       module/fight/rearm.razor
    # ------------------------------------------------------------------------------------
    @setvar! var__rearm_due 0

    if timer "timer__equip" >= interval__equip_retry
        @setvar! var__rearm_due 1
    elseif var__rearm_left != 0 and lhandempty
        @setvar! var__rearm_due 1
    elseif var__rearm_right != 0 and rhandempty
        @setvar! var__rearm_due 1
    endif

    if var__rearm_due = 1
        if not hidden and not queued and not casting and not targetexists
            settimer "timer__equip" 0
            @setvar! var__rearm_sent 0
            @setvar! var__rearm_seen_left 0
            @setvar! var__rearm_seen_right 0

            if findlayer self lefthand as alias__rearm_left
                @setvar! var__rearm_seen_left alias__rearm_left
            endif

            if findlayer self righthand as alias__rearm_right
                @setvar! var__rearm_seen_right alias__rearm_right
            endif

            if config__rearm_follow_hands = 1
                if var__rearm_seen_left != 0 and var__rearm_seen_left != var__rearm_left
                    @setvar! var__rearm_left 0
                    @setvar! var__rearm_right 0
                elseif var__rearm_seen_right != 0 and var__rearm_seen_right != var__rearm_right
                    @setvar! var__rearm_left 0
                    @setvar! var__rearm_right 0
                endif
            endif

            if var__rearm_seen_left != 0
                @setvar! var__rearm_pending 0

                if var__rearm_left != var__rearm_seen_left
                    @setvar! var__rearm_left var__rearm_seen_left

                    if config__sysmsg = 1
                        sysmsg "Rearm: two-handed layer remembered, serial={{var__rearm_left}}." 88
                    endif
                endif
            endif

            if var__rearm_seen_right != 0
                @setvar! var__rearm_pending 0

                if var__rearm_right != var__rearm_seen_right
                    @setvar! var__rearm_right var__rearm_seen_right

                    if config__sysmsg = 1
                        sysmsg "Rearm: one-handed layer remembered, serial={{var__rearm_right}}." 88
                    endif
                endif
            endif

            if var__rearm_seen_left = 0 and var__rearm_left != 0 and timer "timer__equip_sent" >= interval__equip_retry
                if find var__rearm_left backpack as alias__rearm_packed
                    if not hidden and not queued and not casting and not targetexists
                        lift alias__rearm_packed
                        drop self lefthand
                        @setvar! var__rearm_sent 1
                        settimer "timer__equip_sent" 0

                        if config__sysmsg = 1
                            sysmsg "Rearm: equip requested on the two-handed layer, serial={{alias__rearm_packed}}. The next check reads the hands." 88
                        endif

                        wait wait__short
                    endif
                else
                    @setvar! var__rearm_left 0
                endif
            endif

            if var__rearm_sent = 0 and var__rearm_seen_right = 0 and var__rearm_right != 0 and timer "timer__equip_sent" >= interval__equip_retry
                if find var__rearm_right backpack as alias__rearm_packed
                    if not hidden and not queued and not casting and not targetexists
                        lift alias__rearm_packed
                        drop self righthand
                        @setvar! var__rearm_sent 1
                        settimer "timer__equip_sent" 0

                        if config__sysmsg = 1
                            sysmsg "Rearm: equip requested on the one-handed layer, serial={{alias__rearm_packed}}. The next check reads the hands." 88
                        endif

                        wait wait__short
                    endif
                else
                    @setvar! var__rearm_right 0
                endif
            endif

            if var__rearm_sent = 0 and config__rearm_graphic != 0 and var__rearm_left = 0 and var__rearm_right = 0 and lhandempty and rhandempty and timer "timer__equip_sent" >= interval__equip_retry
                if not find var__rearm_pending backpack
                    @setvar! var__rearm_pending 0

                    if findtype config__rearm_graphic backpack as alias__rearm_pick
                        @setvar! var__rearm_pending alias__rearm_pick
                    endif
                endif

                if find var__rearm_pending backpack as alias__rearm_found
                    if not hidden and not queued and not casting and not targetexists
                        lift alias__rearm_found
                        drop self lefthand
                        settimer "timer__equip_sent" 0

                        if config__sysmsg = 1
                            sysmsg "Rearm: graphic {{config__rearm_graphic}} picked from the backpack, serial={{alias__rearm_found}}. The next check reads the hands." 88
                        endif

                        wait wait__short
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ weapon, out ]" 254
                    settimer "timer__message" 0
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # GOLD                                                     module/pack/gold-drop.razor
    # ------------------------------------------------------------------------------------
    if weight > maxweight
        if not hidden and not queued and not casting and not targetexists
            if findtype "gold coin" backpack as alias__found_gold
                lift alias__found_gold config__gold_drop_amount
                droprelloc 0 0
                if config__sysmsg = 1
                    sysmsg "Gold drop: up to {{config__gold_drop_amount}} at your feet, weight over max." 88
                endif
                wait wait__short

                if insysmsg "cannot drop anything"
                    drop backpack -1 -1 -1
                endif

                wait wait__gold_drop
                if config__chatty = 1
                    overhead "[ gold, dropped ]" 290
                endif
            elseif timer "timer__message" >= interval__message
                overhead "[ weight, over ]" 254
                settimer "timer__message" 0
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # STAT POTIONS                                               module/buff/potions.razor
    # ------------------------------------------------------------------------------------
    if var__fighting = 1 and config__use_potions = 1 and timer "timer__potion_check" >= interval__potion_check
        if not queued and not paralyzed and not hidden and not targetexists
            settimer "timer__potion_check" 0

            if str < config__str_potion and timer "timer__str_potion" >= interval__stat_potion
                settimer "timer__str_potion" 0

                if findtype "White Potion" self
                    hotkey "Drink Strength"
                    settimer "timer__potion_check" interval__potion_check
                    wait wait__short
                endif
            endif

            if not queued and dex < config__dex_potion and timer "timer__agi_potion" >= interval__stat_potion
                settimer "timer__agi_potion" 0

                if findtype "Blue Potion" self
                    hotkey "Drink Agility"
                    settimer "timer__potion_check" interval__potion_check
                    wait wait__short
                endif
            endif

            if config__use_resist_potion = 1 and not queued and not findbuff "Magic Resist Potion"
                if findtype "Black Potion" self
                    hotkey "Drink Magic Resist"
                    settimer "timer__potion_check" interval__potion_check
                    wait wait__short
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # SWORD CODEX                                           module/fight/sword-codex.razor
    # ------------------------------------------------------------------------------------
    if var__sword_disabled = 0
        if timer "timer__sword_resync" > interval__sword_resync
            @setvar! var__sword_active 0
            settimer "timer__sword_resync" 0
        endif

        if diffhits > config__defensive_enter_diff
            @setvar! var__sword_want 2
        elseif diffhits < config__defensive_leave_diff
            @setvar! var__sword_want config__sword_stance_main
        endif

        if var__sword_want != var__sword_active and timer "timer__sword_retry" > interval__sword_retry
            settimer "timer__sword_retry" 0

            if findtype 11890 backpack as alias__sword_codex
                getlabel alias__sword_codex label__sword_codex

                if "Warrior" in label__sword_codex
                    @setvar! var__sword_active 4
                elseif "Defensive" in label__sword_codex
                    @setvar! var__sword_active 2
                elseif "Aggressive" in label__sword_codex
                    @setvar! var__sword_active 1
                elseif "Cleave" in label__sword_codex
                    @setvar! var__sword_active 3
                elseif "Flaying" in label__sword_codex
                    @setvar! var__sword_active 5
                else
                    @setvar! var__sword_disabled 1
                    overhead "[ sword stance, off ]" 254
                    if config__sysmsg = 1
                        sysmsg "Sword codex label names no stance, sword stance stands down: {{label__sword_codex}}" 88
                    endif
                endif

                if var__sword_disabled = 0 and var__sword_finisher_checked = 0 and config__sword_finisher_main != 0
                    @setvar! var__sword_finisher_checked 1
                    @setvar! var__sword_finisher_state 0

                    if config__sword_finisher_main = 2
                        if "Execute" in label__sword_codex
                            @setvar! var__sword_finisher_state 1
                        elseif "Bleed Out" in label__sword_codex
                            @setvar! var__sword_finisher_state 2
                        endif
                    else
                        if "Bleed Out" in label__sword_codex
                            @setvar! var__sword_finisher_state 1
                        elseif "Execute" in label__sword_codex
                            @setvar! var__sword_finisher_state 2
                        endif
                    endif

                    if var__sword_finisher_state = 2
                        if config__sword_finisher_main = 1
                            say "[SwordsFinisher1"
                        elseif config__sword_finisher_main = 2
                            say "[SwordsFinisher2"
                        endif
                        if config__sysmsg = 1
                            sysmsg "Sword finisher switch: slot {{config__sword_finisher_main}}." 88
                        endif
                        wait wait__short
                        if config__chatty = 1
                            if config__sword_finisher_main = 2
                                overhead "[ sword, execute ]" 290
                            else
                                overhead "[ sword, bleed out ]" 290
                            endif
                        endif
                    elseif var__sword_finisher_state = 0
                        if config__sword_finisher_main = 2
                            overhead "[ execute, off ]" 254
                        else
                            overhead "[ bleed out, off ]" 254
                        endif
                    endif
                endif

                if var__sword_disabled = 0 and var__sword_want != var__sword_active
                    if config__sysmsg = 1
                        sysmsg "Sword stance switch: slot {{var__sword_active}} to {{var__sword_want}}." 88
                    endif

                    if var__sword_want = 1
                        say "[SwordsStance1"
                    elseif var__sword_want = 2
                        say "[SwordsStance2"
                    elseif var__sword_want = 3
                        say "[SwordsStance3"
                    elseif var__sword_want = 4
                        say "[SwordsStance4"
                    elseif var__sword_want = 5
                        say "[SwordsStance5"
                    endif

                    @setvar! var__sword_active var__sword_want
                    settimer "timer__sword_resync" 0

                    if config__chatty = 1
                        if var__sword_want = 2
                            overhead "[ sword, defensive ]" 290
                        elseif var__sword_want = 4
                            overhead "[ sword, warrior ]" 290
                        elseif var__sword_want = 1
                            overhead "[ sword, aggressive ]" 290
                        elseif var__sword_want = 3
                            overhead "[ sword, cleave ]" 290
                        elseif var__sword_want = 5
                            overhead "[ sword, flaying ]" 290
                        endif
                    endif
                endif
            elseif timer "timer__message" >= interval__message
                overhead "[ sword codex, out ]" 254
                settimer "timer__message" 0
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # PARRY CODEX                                           module/fight/parry-codex.razor
    # ------------------------------------------------------------------------------------
    if timer "timer__parry_check" >= interval__parry_check
        settimer "timer__parry_check" 0

        if timer "timer__parry_resync" >= interval__parry_resync
            @setvar! var__parry_active 0
            @setvar! var__parry_finisher_active 0
            settimer "timer__parry_resync" 0
        endif

        @setvar! var__parry_want config__parry_stance_main

        if poisoned or findbuff "Bleed" or findbuff "Disease"
            if config__parry_dot_in_melee = 1 or not find var__combat_target ground -1 -1 2
                @setvar! var__parry_want config__parry_stance_dot
            endif
        endif

        @setvar! var__parry_can_switch 0

        if timer "timer__parry_hold" >= interval__parry_hold
            @setvar! var__parry_can_switch 1
        elseif var__parry_want = var__parry_sent
            if var__parry_retried = 0
                @setvar! var__parry_can_switch 1
            endif
        endif

        @setvar! var__parry_read 0

        if var__parry_disabled = 0 and var__parry_want != var__parry_active
            if var__parry_can_switch = 1
                @setvar! var__parry_read 1
            endif
        endif

        if var__parry_finisher_off = 0 and config__parry_finisher_main != 0 and config__parry_finisher_main != var__parry_finisher_active
            @setvar! var__parry_read 1
        endif

        if var__parry_confirm = 1
            @setvar! var__parry_read 1
        endif

        if var__parry_read = 1 and timer "timer__parry_retry" >= interval__parry_retry and not hidden and not queued and not casting and not targetexists
            settimer "timer__parry_retry" 0

            if findtype 11889 backpack as alias__parry_codex
                @unsetvar! label__parry_codex
                @setvar! label__parry_codex 0
                getlabel alias__parry_codex label__parry_codex

                if label__parry_codex = 0
                    # No response yet. Leave protection enabled and retry.
                else
                    @setvar! var__parry_confirm 0

                    if var__parry_disabled = 0
                        clearlist 'list__parry_stances'

                        if "Shield Bash" in label__parry_codex
                            pushlist 'list__parry_stances' 1
                            @setvar! var__parry_active 1
                        endif
                        if "Warding" in label__parry_codex
                            pushlist 'list__parry_stances' 2
                            @setvar! var__parry_active 2
                        endif
                        if "Testudo" in label__parry_codex
                            pushlist 'list__parry_stances' 3
                            @setvar! var__parry_active 3
                        endif
                        if "Mirror" in label__parry_codex
                            pushlist 'list__parry_stances' 4
                            @setvar! var__parry_active 4
                        endif
                        if "Bulwark" in label__parry_codex
                            pushlist 'list__parry_stances' 5
                            @setvar! var__parry_active 5
                        endif

                        if list 'list__parry_stances' != 1
                            @setvar! var__parry_disabled 1
                            overhead "[ parry stance, off ]" 254
                            if config__sysmsg = 1
                                sysmsg "Parry codex label names no single stance: {{label__parry_codex}}" 88
                            endif
                        endif
                    endif

                    if var__parry_finisher_off = 0 and config__parry_finisher_main != 0
                        if "Last Stand" in label__parry_codex and "Barrier" in label__parry_codex
                            @setvar! var__parry_finisher_off 1
                        elseif "Last Stand" in label__parry_codex
                            @setvar! var__parry_finisher_active 1
                        elseif "Barrier" in label__parry_codex
                            @setvar! var__parry_finisher_active 2
                        else
                            @setvar! var__parry_finisher_off 1
                        endif

                        if var__parry_finisher_off = 1
                            overhead "[ parry finisher, off ]" 254
                            if config__sysmsg = 1
                                sysmsg "Parry codex label names no single finisher: {{label__parry_codex}}" 88
                            endif
                        elseif config__parry_finisher_main = var__parry_finisher_active
                            @setvar! var__parry_finisher_sent 0
                        elseif var__parry_finisher_sent = 1
                            @setvar! var__parry_finisher_sent 0
                            @setvar! var__parry_finisher_active config__parry_finisher_main
                            if config__sysmsg = 1
                                sysmsg "Parry finisher request not shown, next try at the resync: {{label__parry_codex}}" 88
                            endif
                        else
                            if config__parry_finisher_main = 1
                                say "[ShieldsFinisher1"
                            elseif config__parry_finisher_main = 2
                                say "[ShieldsFinisher2"
                            endif
                            @setvar! var__parry_finisher_active config__parry_finisher_main
                            @setvar! var__parry_finisher_sent 1
                            @setvar! var__parry_confirm 1
                            settimer "timer__parry_retry" 0
                            if config__sysmsg = 1
                                sysmsg "Parry finisher request: slot {{config__parry_finisher_main}}." 88
                            endif
                            if config__chatty = 1
                                if config__parry_finisher_main = 1
                                    overhead "[ parry, last stand ]" 290
                                else
                                    overhead "[ parry, barrier ]" 290
                                endif
                            endif
                            wait wait__short
                        endif
                    endif

                    if var__parry_disabled = 0 and var__parry_want != var__parry_active
                        if var__parry_can_switch = 1
                            @setvar! var__parry_retried 0

                            if var__parry_want = var__parry_sent
                                if timer "timer__parry_hold" < interval__parry_hold
                                    @setvar! var__parry_retried 1
                                endif
                            endif

                            if var__parry_want = 1
                                say "[ShieldsStance1"
                            elseif var__parry_want = 2
                                say "[ShieldsStance2"
                            elseif var__parry_want = 3
                                say "[ShieldsStance3"
                            elseif var__parry_want = 4
                                say "[ShieldsStance4"
                            elseif var__parry_want = 5
                                say "[ShieldsStance5"
                            endif
                            @setvar! var__parry_active var__parry_want
                            @setvar! var__parry_sent var__parry_want
                            @setvar! var__parry_confirm 1
                            settimer "timer__parry_hold" 0
                            settimer "timer__parry_resync" 0
                            settimer "timer__parry_retry" 0
                            if config__sysmsg = 1
                                sysmsg "Parry stance request: slot {{var__parry_want}}." 88
                            endif
                            if config__chatty = 1
                                if var__parry_want = 3
                                    overhead "[ parry, testudo ]" 290
                                elseif var__parry_want = 2
                                    overhead "[ parry, warding ]" 290
                                elseif var__parry_want = 1
                                    overhead "[ parry, shield bash ]" 290
                                elseif var__parry_want = 4
                                    overhead "[ parry, mirror ]" 290
                                elseif var__parry_want = 5
                                    overhead "[ parry, bulwark ]" 290
                                endif
                            endif
                        endif
                    endif
                endif
            elseif timer "timer__message" >= interval__message
                overhead "[ shield codex, out ]" 254
                settimer "timer__message" 0
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # WEAPON ABILITY                                     module/fight/weapon-ability.razor
    # ------------------------------------------------------------------------------------
    if timer "timer__ability" >= interval__ability and not hidden and not queued and not casting and not targetexists and find var__combat_target ground -1 -1 config__ability_range as alias__ability_target
        if not dead alias__ability_target
            @setvar! var__ability_weapon_ok 0

            if config__ability_weapon_graphic = 0
                @setvar! var__ability_weapon_ok 1
            elseif findtype config__ability_weapon_graphic self as alias__ability_weapon
                @setvar! var__ability_weapon alias__ability_weapon

                if findlayer self lefthand as alias__ability_held
                    if alias__ability_held = var__ability_weapon
                        @setvar! var__ability_weapon_ok 1
                    endif
                endif

                if findlayer self righthand as alias__ability_held
                    if alias__ability_held = var__ability_weapon
                        @setvar! var__ability_weapon_ok 1
                    endif
                endif
            endif

            if var__ability_weapon_ok = 1
                if config__ability_main = 1
                    say "[WeaponAbility1"
                elseif config__ability_main = 2
                    say "[WeaponAbility2"
                elseif config__ability_main = 3
                    say "[WeaponAbility3"
                endif

                settimer "timer__ability" 0
                if config__sysmsg = 1
                    sysmsg "Weapon ability request: codex {{config__ability_codex}}, slot {{config__ability_main}}. Fires on the next hit." 88
                endif

                if config__chatty = 1
                    if config__ability_codex = 2
                        if config__ability_main = 3
                            overhead "[ repeater ]" 219
                        elseif config__ability_main = 2
                            overhead "[ full draw ]" 219
                        elseif config__ability_main = 1
                            overhead "[ skirmish ]" 219
                        endif
                    elseif config__ability_codex = 3
                        if config__ability_main = 1
                            overhead "[ brawl ]" 219
                        elseif config__ability_main = 2
                            overhead "[ haymaker ]" 219
                        elseif config__ability_main = 3
                            overhead "[ takedown ]" 219
                        endif
                    elseif config__ability_main = 3
                        overhead "[ chop ]" 219
                    elseif config__ability_main = 1
                        overhead "[ spinslash ]" 219
                    elseif config__ability_main = 2
                        overhead "[ rend ]" 219
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # SELF BUFFS                                                  module/buff/spells.razor
    # ------------------------------------------------------------------------------------
    if config__use_magery = 1 and var__hold_casts = 0 and not paralyzed and not hidden and not queued and not casting and not targetexists and diffhits < config__buff_max_loss
        if config__buff_when_poisoned = 1 or not poisoned
            if config__warmode_is_manual = 0 or not warmode
                if config__walk_guard = 0 or cooldown "walk" = 0
                    if config__use_reactive_armor = 1 and var__regs_reactive_armor = 1 and mana >= config__mana_reactive_armor and not findbuff "Reactive Armor"
                        cast "Reactive Armor"
                        if config__sysmsg = 1
                            sysmsg "Buff: Reactive Armor." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor
                    elseif config__use_magic_reflect = 1 and var__regs_magic_reflect = 1 and mana >= config__mana_magic_reflect and cooldown "reflect" = 0 and not findbuff "Magic Reflection"
                        cast "Magic Reflection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Magic Reflection." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor
                    elseif config__use_protection = 1 and var__regs_protection = 1 and mana >= config__mana_protection and not findbuff "Protection"
                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            # consumed, nothing else to do
                        endif

                        cast "Protection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Protection." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if not casting
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "beneficial" or targetexists "neutral"
                            target self

                            for 10
                                if findbuff "Protection"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_bless = 1 and var__fighting = 0 and not warmode and var__regs_bless = 1 and mana >= config__mana_bless and not findbuff "Cunning"
                        cast "Bless"
                        if config__sysmsg = 1
                            sysmsg "Buff: Bless." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "beneficial"
                            target self

                            for 10
                                if findbuff "Cunning"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_arch_protection = 1 and var__fighting = 0 and not warmode and var__regs_arch_protection = 1 and mana >= config__mana_arch_protection and not findbuff "Protection"
                        cast "Arch Protection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Arch Protection." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "neutral"
                            target self

                            for 10
                                if findbuff "Protection"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_spell_siphon = 1 and not warmode and var__regs_magic_arrow = 1 and mana >= config__mana_spell_siphon and not findbuff "Spell Siphon" and not findbuff "Magic Reflection"
                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            # consumed, nothing else to do
                        endif

                        cast "Magic Arrow"
                        if config__sysmsg = 1
                            sysmsg "Buff: Magic Arrow on yourself for Spell Siphon." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "harmful"
                            hotkey 'Target Self'
                            wait wait__cast
                        elseif targetexists
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # SKINNING                                                module/gather/skinning.razor
    # ------------------------------------------------------------------------------------
    if insysmsg "Criminal actions are not permitted"
        settimer "timer__grey_only" 0
        if config__sysmsg = 1
            sysmsg "Carve mode: grey corpses only for 5 minutes after a criminal action refusal." 88
        endif
    endif

    if timer "timer__carve" >= interval__carve and var__combat_target = 0
        settimer "timer__carve" 0
        @setvar! var__carve_direct 0

        if config__skin_unowned = 1 and var__carve_crime = 0 and timer "timer__grey_only" >= interval__grey_only
            @setvar! var__carve_direct 1
        endif

        if diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not queued and not casting and not targetexists and findtype 8198 ground -1 -1 2 as alias__corpse
            @setvar! var__corpse_ok 1

            if var__carve_direct = 1
                getlabel alias__corpse label__corpse
                @setvar! var__corpse_ok 0

                if "corpse" in label__corpse or "Corpse" in label__corpse
                    @setvar! var__corpse_ok 1
                endif

                if "remains" in label__corpse or "Remains" in label__corpse
                    @setvar! var__corpse_ok 0
                endif

                if var__corpse_ok = 0
                    @ignore alias__corpse
                    if config__sysmsg = 1
                        sysmsg "Carve skip: corpse={{alias__corpse}}, label={{label__corpse}}." 88
                    endif
                endif
            endif

            if var__corpse_ok = 1
                if not find var__my_knife backpack
                    @setvar! var__my_knife 0

                    if findtype 11552|11564 backpack as alias__packed_knife
                        @setvar! var__my_knife alias__packed_knife
                    endif
                endif

                if find var__my_knife backpack as alias__knife
                    dclick alias__knife
                    waitfortarget wait__carve_target

                    if targetexists "neutral" and not hidden
                        @setvar! var__pick_during_carve 0

                        if find lastharmful ground -1 -1 config__acquire_range as alias__fresh_target
                            @setvar! var__fresh_serial alias__fresh_target

                            if 0x40000000 > var__fresh_serial
                                if not dead alias__fresh_target
                                    if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                        @setvar! var__pick_during_carve 1
                                        @setvar! var__combat_target alias__fresh_target
                                        settimer "timer__target_grace" 0
                                    endif
                                endif
                            endif
                        endif

                        if var__pick_during_carve = 1
                            hotkey "Cancel Current Target"
                            if config__sysmsg = 1
                                sysmsg "Carve cancelled: an enemy was picked during the knife cursor." 88
                            endif
                            wait wait__short
                        elseif var__carve_direct = 1
                            target alias__corpse
                            if config__sysmsg = 1
                                sysmsg "Carve request: corpse={{alias__corpse}}." 88
                            endif
                            @setvar! var__carve_reply 0
                            settimer "timer__carve" 0

                            while var__carve_reply = 0 and timer "timer__carve" < wait__carve_reply
                                if insysmsg "corpse carving on"
                                    @setvar! var__carve_reply 3
                                    @setvar! var__carve_crime 1
                                    overhead "[ carve, grey only ]" 254
                                elseif insysmsg "Criminal actions are not permitted"
                                    @setvar! var__carve_reply 3
                                    settimer "timer__grey_only" 0
                                elseif insysmsg "You carve materials"
                                    @setvar! var__carve_reply 1
                                elseif insysmsg "already been carved"
                                    @setvar! var__carve_reply 1
                                elseif insysmsg "too far away"
                                    @setvar! var__carve_reply 2
                                elseif insysmsg "must wait to perform another action"
                                    @setvar! var__carve_reply 2
                                else
                                    wait wait__poll
                                endif
                            endwhile

                            if var__carve_reply = 2 and var__carve_retry != alias__corpse
                                @setvar! var__carve_retry alias__corpse
                            else
                                @ignore alias__corpse
                                @setvar! var__carve_retry 0
                            endif

                            if config__sysmsg = 1
                                if var__carve_reply = 1
                                    sysmsg "Carve done: corpse={{alias__corpse}}." 88
                                elseif var__carve_reply = 2 and var__carve_retry = alias__corpse
                                    sysmsg "Carve miss: corpse={{alias__corpse}}, too far or busy. One more try." 88
                                elseif var__carve_reply = 2
                                    sysmsg "Carve miss again: corpse={{alias__corpse}}. Skipped." 88
                                elseif var__carve_reply = 3
                                    sysmsg "Carve refused as criminal: corpse={{alias__corpse}}. Grey corpses only for now." 88
                                else
                                    sysmsg "Carve no reply: corpse={{alias__corpse}}. Skipped." 88
                                endif
                            endif
                        else
                            target self
                            if config__sysmsg = 1
                                sysmsg "Carve request: Smart Harvest." 88
                            endif
                            @setvar! var__carve_reply 0
                            settimer "timer__carve" 0

                            while var__carve_reply = 0 and timer "timer__carve" < wait__carve_reply
                                if insysmsg "worth carving"
                                    @setvar! var__carve_reply 2
                                elseif insysmsg "You carve materials"
                                    @setvar! var__carve_reply 1
                                else
                                    wait wait__poll
                                endif
                            endwhile

                            if var__carve_reply = 2
                                for 10
                                    if findtype 8198 ground -1 -1 2 as alias__carved_corpse
                                        @ignore alias__carved_corpse
                                    endif
                                endfor
                            endif

                            if config__sysmsg = 1
                                if var__carve_reply = 1
                                    sysmsg "Smart Harvest: carved." 88
                                elseif var__carve_reply = 2
                                    sysmsg "Smart Harvest: nothing left here. Corpses within 2 tiles skipped." 88
                                else
                                    sysmsg "Smart Harvest: no reply." 88
                                endif
                            endif
                        endif
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ knife, out ]" 254
                    settimer "timer__message" 0
                endif
            endif
        endif

        settimer "timer__carve" 0
    endif

    # ------------------------------------------------------------------------------------
    # REAGENTS                                                module/magery/reagents.razor
    # ------------------------------------------------------------------------------------
    if config__use_magery = 1
        if timer "timer__reagents" >= interval__reagents or insysmsg "More reagents are needed"
            settimer "timer__reagents" 0

            @setvar! var__has_black_pearl 0
            @setvar! var__has_bloodmoss 0
            @setvar! var__has_garlic 0
            @setvar! var__has_ginseng 0
            @setvar! var__has_mandrake 0
            @setvar! var__has_nightshade 0
            @setvar! var__has_ash 0
            @setvar! var__has_silk 0

            if findtype 3962 self
                @setvar! var__has_black_pearl 1
            endif

            if findtype 3963 self
                @setvar! var__has_bloodmoss 1
            endif

            if findtype 3972 self
                @setvar! var__has_garlic 1
            endif

            if findtype 3973 self
                @setvar! var__has_ginseng 1
            endif

            if findtype 3974 self
                @setvar! var__has_mandrake 1
            endif

            if findtype 3976 self
                @setvar! var__has_nightshade 1
            endif

            if findtype 3980 self
                @setvar! var__has_ash 1
            endif

            if findtype 3981 self
                @setvar! var__has_silk 1
            endif

            @setvar! var__regs_cure 0
            @setvar! var__regs_heal 0
            @setvar! var__regs_greater_heal 0
            @setvar! var__regs_create_food 0
            @setvar! var__regs_reactive_armor 0
            @setvar! var__regs_magic_reflect 0
            @setvar! var__regs_magic_arrow 0
            @setvar! var__regs_harm 0
            @setvar! var__regs_fireball 0
            @setvar! var__regs_lightning 0
            @setvar! var__regs_curse 0
            @setvar! var__regs_mana_drain 0
            @setvar! var__regs_energy_bolt 0
            @setvar! var__regs_bless 0
            @setvar! var__regs_protection 0
            @setvar! var__regs_arch_protection 0
            @setvar! var__regs_flamestrike 0
            @setvar! var__regs_summon 0
            @setvar! var__regs_summon_ash 0

            if var__has_garlic = 1 and var__has_ginseng = 1
                @setvar! var__regs_cure 1
            endif

            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_silk = 1
                @setvar! var__regs_heal 1
            endif

            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_greater_heal 1
            endif

            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1
                @setvar! var__regs_create_food 1
            endif

            if var__has_garlic = 1 and var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_reactive_armor 1
            endif

            if var__has_garlic = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_magic_reflect 1
            endif

            if var__has_ash = 1
                @setvar! var__regs_magic_arrow 1
            endif

            if var__has_nightshade = 1 and var__has_silk = 1
                @setvar! var__regs_harm 1
            endif

            if var__has_black_pearl = 1
                @setvar! var__regs_fireball 1
            endif

            if var__has_mandrake = 1 and var__has_ash = 1
                @setvar! var__regs_lightning 1
            endif

            if var__has_garlic = 1 and var__has_nightshade = 1 and var__has_ash = 1
                @setvar! var__regs_curse 1
            endif

            if var__has_black_pearl = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_mana_drain 1
            endif

            if var__has_black_pearl = 1 and var__has_nightshade = 1
                @setvar! var__regs_energy_bolt 1
            endif

            if var__has_garlic = 1 and var__has_mandrake = 1
                @setvar! var__regs_bless 1
            endif

            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_ash = 1
                @setvar! var__regs_protection 1
            endif

            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1 and var__has_ash = 1
                @setvar! var__regs_arch_protection 1
            endif

            if var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_flamestrike 1
            endif

            if var__has_bloodmoss = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_summon 1
            endif

            if var__has_bloodmoss = 1 and var__has_mandrake = 1 and var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_summon_ash 1
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # FOOD                                                          module/buff/food.razor
    # ------------------------------------------------------------------------------------
    if timer "timer__food" >= interval__food and not findbuff "Food Satisfaction"
        if config__warmode_is_manual = 0 or not warmode
            if not hidden and not queued and not casting and not targetexists
                settimer "timer__food" 0

                if findtype tray backpack as alias__food
                    dclick alias__food
                    wait wait__short
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # LEATHER                                                    module/pack/leather.razor
    # ------------------------------------------------------------------------------------
    if timer "timer__pack_leather" >= interval__pack_leather and var__combat_target = 0
        if diffhits < config__heal_hits and not poisoned and not paralyzed
            if not hidden and not queued and not casting and not targetexists
                settimer "timer__pack_leather" 0

                if find global__my_loot_bag backpack
                    if config__sysmsg = 1
                        sysmsg "Leather pack BEGIN." 88
                    endif
                    dclick global__my_loot_bag
                    wait wait__pack_item
                    settimer "timer__pack_leather" 0

                    while queued and timer "timer__pack_leather" < wait__pack_batch and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists
                        wait wait__poll
                    endwhile

                    while timer "timer__pack_leather" < wait__pack_batch and not queued and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists and find global__my_loot_bag backpack and findtype 4225 backpack as alias__leather_stack
                        if find alias__leather_stack global__my_loot_bag
                            @ignore alias__leather_stack
                        else
                            if config__sysmsg = 1
                                sysmsg "Leather move request: serial={{alias__leather_stack}}." 88
                            endif
                            lift alias__leather_stack 60000
                            drop global__my_loot_bag -1 -1
                            wait wait__pack_item
                        endif

                        while queued and timer "timer__pack_leather" < wait__pack_batch and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists
                            wait wait__poll
                        endwhile
                    endwhile
                    if config__sysmsg = 1
                        sysmsg "Leather pack END." 88
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ loot bag, out ]" 254
                    settimer "timer__message" 0
                endif
                settimer "timer__pack_leather" 0
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # END OF PASS                                                        module/base.razor
    # ------------------------------------------------------------------------------------
    wait wait__poll
endwhile
