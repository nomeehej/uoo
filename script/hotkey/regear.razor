# ----------------------------------------------------------------------------------------
if pvp
    overhead "[ script, blocked ]" 254
    stop
endif

if config__clear_at_start = 1
    clearall
    clearsysmsg
    cleardragdrop
    clearignore
endif


# ----------------------------------------------------------------------------------------
# module/recovery/heal-first.razor
# ----------------------------------------------------------------------------------------
while diffhits > config__heal_first_until and timer "timer__heal_first" < wait__heal_first and not dead
    @setvar! var__heal_first_can 0

    if bandaging or casting or targetexists "beneficial"
        @setvar! var__heal_first_can 1
    endif

    if config__use_bandages = 1 and not bandaging and not paralyzed and not targetexists and skill "Healing" > config__heal_skill_min and findtype 3617 self
        hotkey "Bandage Self"
        @setvar! var__heal_first_can 1
        wait wait__short
    endif

    if config__use_potions = 1 and not targetexists and findtype "Yellow Potion" self as alias__heal_first_potion
        @setvar! var__heal_first_can 1
        getlabel alias__heal_first_potion label__heal_first_potion

        if "next usable" in label__heal_first_potion
            # Still on its own cooldown.
        else
            hotkey "Drink Heal"
            wait wait__short
        endif
    endif

    if insysmsg "More reagents are needed"
        @setvar! var__heal_first_no_greater_heal 1
    endif

    if config__use_magery = 1 and var__heal_first_no_greater_heal = 0 and skill "Magery" >= 50 and mana >= config__heal_first_mana and not casting and not targetexists
        hotkey "> Greater Heal/Cure Self"
        @setvar! var__heal_first_can 1
        wait wait__short
    endif

    if var__heal_first_can = 0
        settimer "timer__heal_first" wait__heal_first
    endif

    wait wait__short
endwhile

if targetexists "beneficial"
    hotkey "Cancel Current Target"
    wait wait__short
endif


