            drop backpack 76 200
        elseif index = 5
            drop backpack 48 130
        elseif index = 6
            drop backpack 56 130
        elseif index = 7
            drop backpack 64 130
        elseif index = 8
            drop backpack 72 130
        elseif index = 9
            drop backpack 80 130
