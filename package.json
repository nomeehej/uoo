{
    "name": "uoo",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.2",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "node util/build-scripts.mjs",
        "check": "util/check.sh && pnpm typecheck && pnpm docs:build && node util/check-docs.mjs",
        "test": "node --test util/*.test.mjs",
        "docs:dev": "for-humanity dev",
        "docs:build": "for-humanity build && cp content/asset/favicon.svg content/dist/favicon.svg",
        "docs:preview": "for-humanity preview",
        "typecheck": "tsc"
    },
    "devDependencies": {
        "for-humanity": "0.26.1",
        "parse5": "7.3.0",
        "typescript": "7.0.2"
    }
}
