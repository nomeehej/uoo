# ----------------------------------------------------------------------------------------
# Reactive Armor, then Magic Reflection, whenever one is missing.
# Protection, Bless, Arch Protection and the Spell Siphon arrow are off by default.
#
# @ hotkeys > Interrupt, Cancel Current Target, Target Self
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__use_reactive_armor
#      1 keeps Reactive Armor up.
#
#   config__use_magic_reflect
#      1 keeps Magic Reflection up.
#
#   config__mana_reactive_armor
#      Minimum current mana to start Reactive Armor.
#
#   config__mana_magic_reflect
#      Minimum current mana to start Magic Reflection.
#
#   config__use_protection
#      1 keeps Protection on yourself, in a fight too. Follows warmode_is_manual, like
#      Reactive Armor and Magic Reflection. Arch Protection shows the same Protection
#      icon, so one of the two is enough.
#
#   config__mana_protection
#      Minimum current mana to start Protection.
#
#   config__use_bless, config__use_arch_protection
#      1 keeps Bless on yourself, and Arch Protection on you and the followers around you,
#      while no enemy is engaged (var__fighting 0) and warmode is off. Both open a cursor
#      answered with yourself, Bless a beneficial one and Arch Protection a neutral one, so
#      they never take a cast from a fight.
#
#   config__mana_bless, config__mana_arch_protection
#      Minimum current mana to start Bless and Arch Protection.
#
#   config__use_spell_siphon
#      1 keeps the Spell Siphon buff up with a Magic Arrow on yourself, never while Magic
#      Reflection is up, since the arrow would only burn the reflection. Warmode off.
#
#   config__mana_spell_siphon
#      Minimum current mana to start the Spell Siphon arrow.
#
#   config__buff_max_loss
#      Missing hit points at which buffs are not started, and cut mid cast.
#
#   config__buff_when_poisoned
#      Buffs while poisoned.
#        0  no: hold them back and cut one that is casting, so the cure goes first
#        1  yes
# ----------------------------------------------------------------------------------------
@setvar! config__use_reactive_armor 1
@setvar! config__use_magic_reflect 1
@setvar! config__mana_reactive_armor 4
@setvar! config__mana_magic_reflect 14
@setvar! config__use_protection 0
@setvar! config__mana_protection 6
@setvar! config__use_bless 0
@setvar! config__use_arch_protection 0
@setvar! config__mana_bless 9
@setvar! config__mana_arch_protection 11
@setvar! config__use_spell_siphon 0
@setvar! config__mana_spell_siphon 4
@setvar! config__buff_max_loss 35
@setvar! config__buff_when_poisoned 1


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # SELF BUFFS
    #
    # One cast per pass, in this order: Reactive Armor and Magic Reflection whenever one is
    # missing, then Protection, then Bless and Arch Protection out of a fight, then the
    # Spell Siphon arrow. Not started at config__buff_max_loss, and cut there mid cast so
    # the next pass can heal. With config__buff_when_poisoned 0 poison holds them back and
    # cuts them too, so the cure goes first. var__hold_casts lets another block keep the
    # cast window (a latched Recall). config__walk_guard and config__warmode_is_manual
    # apply as for the heal agents. Bless, Arch Protection and the Spell Siphon arrow
    # also stand down in warmode.
    #
    # The reflect bar is the server's recast lock after Reflect is used up. Bless shows
    # Strength, Agility and Cunning, and only Cunning is Bless alone, since the stat potions
    # show the other two. Protection and Arch Protection both show Protection. Each icon
    # arrives a round trip after the target, so the block waits for it before the next pass
    # reads it. The wiki gives Protection as the caster's own armor, so whether it opens a
    # cursor is not known: its poll takes either end, a cursor is answered with yourself
    # and its icon waited for as Bless's is, and without one it ends like Reactive Armor.
    # Spell Siphon starts on the first spell to hit us and lasts sixty minutes, so the
    # arrow goes out about once an hour.
    # ------------------------------------------------------------------------------------
    if config__use_magery = 1 and var__hold_casts = 0 and not paralyzed and not hidden and not queued and not casting and not targetexists and diffhits < config__buff_max_loss
        if config__buff_when_poisoned = 1 or not poisoned
            if config__warmode_is_manual = 0 or not warmode
                if config__walk_guard = 0 or cooldown "walk" = 0
                    if config__use_reactive_armor = 1 and var__regs_reactive_armor = 1 and mana >= config__mana_reactive_armor and not findbuff "Reactive Armor"
                        cast "Reactive Armor"
                        if config__sysmsg = 1
                            sysmsg "Buff: Reactive Armor." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor
                    elseif config__use_magic_reflect = 1 and var__regs_magic_reflect = 1 and mana >= config__mana_magic_reflect and cooldown "reflect" = 0 and not findbuff "Magic Reflection"
                        cast "Magic Reflection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Magic Reflection." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor
                    elseif config__use_protection = 1 and var__regs_protection = 1 and mana >= config__mana_protection and not findbuff "Protection"
                        # A disturb line an earlier cast left is read off first, so the poll sees only its own.
                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            # consumed, nothing else to do
                        endif

                        cast "Protection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Protection." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if not casting
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "beneficial" or targetexists "neutral"
                            target self

                            for 10
                                if findbuff "Protection"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            # Not the cursor this spell opens. Left open it would hold every block.
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_bless = 1 and var__fighting = 0 and not warmode and var__regs_bless = 1 and mana >= config__mana_bless and not findbuff "Cunning"
                        cast "Bless"
                        if config__sysmsg = 1
                            sysmsg "Buff: Bless." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "beneficial"
                            target self

                            for 10
                                if findbuff "Cunning"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            # Not the cursor this spell opens. Left open it would hold every block.
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_arch_protection = 1 and var__fighting = 0 and not warmode and var__regs_arch_protection = 1 and mana >= config__mana_arch_protection and not findbuff "Protection"
                        cast "Arch Protection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Arch Protection." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "neutral"
                            target self

                            for 10
                                if findbuff "Protection"
                                    break
                                endif

                                wait wait__poll
                            endfor
                        elseif targetexists
                            # Not the cursor this spell opens. Left open it would hold every block.
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    elseif config__use_spell_siphon = 1 and not warmode and var__regs_magic_arrow = 1 and mana >= config__mana_spell_siphon and not findbuff "Spell Siphon" and not findbuff "Magic Reflection"
                        # A disturb line an earlier cast left is read off first, so the poll sees only its own.
                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            # consumed, nothing else to do
                        endif

                        cast "Magic Arrow"
                        if config__sysmsg = 1
                            sysmsg "Buff: Magic Arrow on yourself for Spell Siphon." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif

                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif

                            wait wait__poll
                        endfor

                        if targetexists "harmful"
                            hotkey 'Target Self'
                            wait wait__cast
                        elseif targetexists
                            # Not the cursor this spell opens. Left open it would hold every block.
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    endif
                endif
            endif
        endif
    endif
