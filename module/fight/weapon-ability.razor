# ----------------------------------------------------------------------------------------
# The weapon ability on the remembered enemy in reach, once per meter fill.
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__ability_codex
#      The codex the held weapon belongs to, which names the three ability slots.
#        1  Swords: Spinslash, Rend, Chop
#        2  Archery: Skirmish, Full Draw, Repeater
#        3  Wrestling: Brawl, Haymaker, Takedown
#
#   config__ability_main
#      Weapon ability to use, by its slot in that codex.
#        1  Spinslash, Skirmish, or Brawl
#        2  Rend, Full Draw, or Haymaker
#        3  Chop, Repeater, or Takedown
#
#   config__ability_range
#      How far, in tiles, the remembered enemy may be for the request. 2 for a melee
#      weapon, the weapon's reach for a bow.
#
#   config__ability_weapon_graphic
#      Required held weapon graphic. 0 keeps the existing unrestricted behavior.
#      findtype on self also finds the backpack, so a hand layer must hold the serial
#      it returns. A spare of the same graphic in the backpack can hide a held one.
# ----------------------------------------------------------------------------------------
@setvar! config__ability_codex 1
@setvar! config__ability_main 3
@setvar! config__ability_range 2
@setvar! config__ability_weapon_graphic 0


# ----------------------------------------------------------------------------------------
# @ wait
#
#   interval__ability
#      Without Arms Lore the ability meter takes 60 seconds to fill.
# ----------------------------------------------------------------------------------------
@setvar! interval__ability 60000


# ----------------------------------------------------------------------------------------
# @ timer
# ----------------------------------------------------------------------------------------
timer__ability interval__ability


# ----------------------------------------------------------------------------------------
# @ state
#
#   var__ability_weapon_ok
#      Scratch flag. 1 when no equipment restriction is set or that weapon is held.
#
#   var__ability_weapon
#      Scratch serial of the required weapon graphic, compared with both hand layers.
# ----------------------------------------------------------------------------------------
@setvar! var__ability_weapon_ok 0
@setvar! var__ability_weapon 0


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # WEAPON ABILITY
    #
    # The three abilities of a codex share one meter, and the requested one fires on the
    # next hit. Swords: Chop is the default, one hit at +250%, independent of weapon
    # specials. Spinslash spreads +15% over 15 seconds, about two hits' worth. Rend needs
    # bleeds already on the target. Archery: Repeater makes three hits at 75% each at
    # once. Full Draw adds 50% for 15 seconds, and a speed 20 crossbow fires about 4.2
    # times in that, so 208% against 225%, and only while standing. Skirmish adds 35% and
    # fires on the move (Archery 04). Chop and Repeater are further scaled by weapon
    # speed, and that formula is not documented. A timer spaces the request, as in
    # archive/bard-mace. This spaces requests, not confirmed activations. Requests can
    # precede the next hit and the server can reject one if the meter is not ready.
    # Wrestling defaults to Brawl for sustained attacks. All three share the same meter.
    # Effects and slots: wiki Wrestling and Weapon_and_Parry_Codex, read 2026-10-27.
    # ------------------------------------------------------------------------------------
    if timer "timer__ability" >= interval__ability and not hidden and not queued and not casting and not targetexists and find var__combat_target ground -1 -1 config__ability_range as alias__ability_target
        if not dead alias__ability_target
            @setvar! var__ability_weapon_ok 0

            if config__ability_weapon_graphic = 0
                @setvar! var__ability_weapon_ok 1
            elseif findtype config__ability_weapon_graphic self as alias__ability_weapon
                @setvar! var__ability_weapon alias__ability_weapon

                if findlayer self lefthand as alias__ability_held
                    if alias__ability_held = var__ability_weapon
                        @setvar! var__ability_weapon_ok 1
                    endif
                endif

                if findlayer self righthand as alias__ability_held
                    if alias__ability_held = var__ability_weapon
                        @setvar! var__ability_weapon_ok 1
                    endif
                endif
            endif

            if var__ability_weapon_ok = 1
                if config__ability_main = 1
                    say "[WeaponAbility1"
                elseif config__ability_main = 2
                    say "[WeaponAbility2"
                elseif config__ability_main = 3
                    say "[WeaponAbility3"
                endif

                settimer "timer__ability" 0
                if config__sysmsg = 1
                    sysmsg "Weapon ability request: codex {{config__ability_codex}}, slot {{config__ability_main}}. Fires on the next hit." 88
                endif

                if config__chatty = 1
                    if config__ability_codex = 2
                        if config__ability_main = 3
                            overhead "[ repeater ]" 219
                        elseif config__ability_main = 2
                            overhead "[ full draw ]" 219
                        elseif config__ability_main = 1
                            overhead "[ skirmish ]" 219
                        endif
                    elseif config__ability_codex = 3
                        if config__ability_main = 1
                            overhead "[ brawl ]" 219
                        elseif config__ability_main = 2
                            overhead "[ haymaker ]" 219
                        elseif config__ability_main = 3
                            overhead "[ takedown ]" 219
                        endif
                    elseif config__ability_main = 3
                        overhead "[ chop ]" 219
                    elseif config__ability_main = 1
                        overhead "[ spinslash ]" 219
                    elseif config__ability_main = 2
                        overhead "[ rend ]" 219
                    endif
                endif
            endif
        endif
    endif
