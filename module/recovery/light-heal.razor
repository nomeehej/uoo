# ----------------------------------------------------------------------------------------
# The light Heal agent: the bandage stand-in, or beside them with use_light_heal 1.
#
# @ hotkeys > Smart Heal/Cure Self, Cancel Current Target
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__use_light_heal
#      When the light Heal goes.
#        0  only while no bandage can run: use_bandages 0, Healing at or below heal_skill_min,
#           or none left and none running
#        1  beside the bandages too
#
#   config__light_hits
#      Missing hit points that start the light Heal.
#
#   config__mana_heal
#      Minimum current mana for the light Heal.
# ----------------------------------------------------------------------------------------
@setvar! config__use_light_heal 0
@setvar! config__light_hits 15
@setvar! config__mana_heal 4


# ----------------------------------------------------------------------------------------
# @ state
#
#   var__light_heal_due
#      Scratch: 1 when the light Heal goes on this pass.
# ----------------------------------------------------------------------------------------
@setvar! var__light_heal_due 0


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # LIGHT HEAL
    #
    # The bandage stand-in whenever no bandage can run: bandages off, no Healing, or none
    # left and none running. Beside the bandages only with config__use_light_heal 1. The
    # agent waits for the walk bar and for warmode as config__walk_guard and
    # config__warmode_is_manual say. Its poll waits for the cast to show first, as in
    # recovery/heal.
    # ------------------------------------------------------------------------------------
    if not poisoned and not paralyzed and not hidden and not queued and not casting and not targetexists and config__use_magery = 1 and var__regs_heal = 1 and diffhits >= config__light_hits and mana >= config__mana_heal
        @setvar! var__light_heal_due 0

        if config__use_light_heal = 1 or config__use_bandages = 0 or skill "Healing" <= config__heal_skill_min
            @setvar! var__light_heal_due 1
        elseif not bandaging and not findtype 3617 self
            @setvar! var__light_heal_due 1
        endif

        if var__light_heal_due = 1
            if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                if config__walk_guard = 0 or cooldown "walk" = 0
                    hotkey "> Smart Heal/Cure Self"
                    if config__sysmsg = 1
                        sysmsg "Agent: Smart Heal/Cure Self, light Heal." 88
                    endif
                    settimer "timer__cast_start" 0

                    while not casting and timer "timer__cast_start" < wait__cast_start
                        wait wait__poll
                    endwhile

                    if not casting and config__sysmsg = 1
                        sysmsg "Agent: no cast seen within {{wait__cast_start}} ms." 88
                    endif

                    for 60
                        if not casting
                            break
                        endif

                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            break
                        endif

                        wait wait__poll
                    endfor

                    if targetexists "beneficial" and diffhits = 0
                        hotkey "Cancel Current Target"
                        wait wait__short
                    endif
                endif
            endif
        endif
    endif
