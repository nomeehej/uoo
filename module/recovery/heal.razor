# ----------------------------------------------------------------------------------------
# Heal potion at heal_hits, else Greater Heal at emergency_hits.
#
# @ hotkeys Drink Heal, > Greater Heal/Cure Self, Cancel Current Target
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__heal_hits
#      Missing hit points (not percent) that drink a heal potion.
#
#   config__emergency_hits
#      Missing hit points that cast Greater Heal when no heal potion went out on this
#      pass. Not below heal_hits.
#
#   config__mana_greater_heal
#      Minimum current mana for Greater Heal. It keeps no reserve: 31 always leaves 20
#      mana for an attack or Teleport.
# ----------------------------------------------------------------------------------------
@setvar! config__heal_hits 35
@setvar! config__emergency_hits 35
@setvar! config__mana_greater_heal 11


# ----------------------------------------------------------------------------------------
# @ wait
#
#   cooldown__heal_potion
#      Length of the heal pot bar this block starts when it drinks, so the bar runs even
#      where no trigger starts it.
# ----------------------------------------------------------------------------------------
@setvar! cooldown__heal_potion 10000


# ----------------------------------------------------------------------------------------
# @ state
#
#   var__heal_potion_out
#      Scratch: 1 once a heal potion went out on this pass.
# ----------------------------------------------------------------------------------------
@setvar! var__heal_potion_out 0


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # HEAL
    #
    # Heavy damage drinks first, because the potion is instant and goes out during a cast.
    # Greater Heal follows when no potion went out on this pass and the loss is at the
    # emergency line: none carried, on its own cooldown, or the bar still running. The bar
    # skips the label read while it runs. The label stays authoritative when the bar is
    # missing. Greater Heal waits for warmode as config__warmode_is_manual says, but not
    # for the walk bar: a run keeps that bar going, and at the emergency line a cast a step
    # may break beats none. The agent shows as casting a moment after its hotkey, so the
    # poll first waits up to wait__cast_start for it. Polling at once left before the cast
    # showed, and fight/rearm armed over it and broke it (reported 2026-10-30).
    # ------------------------------------------------------------------------------------
    if not poisoned and not paralyzed and not hidden and not queued and not targetexists and diffhits >= config__heal_hits
        @setvar! var__heal_potion_out 0

        if config__use_potions = 1 and cooldown "heal pot" = 0
            if findtype "Yellow Potion" self as alias__heal_potion
                getlabel alias__heal_potion label__heal_potion

                if "next usable" in label__heal_potion
                    # Still on its own cooldown.
                else
                    hotkey "Drink Heal"
                    cooldown "heal pot" cooldown__heal_potion
                    @setvar! var__heal_potion_out 1
                    wait wait__short
                endif
            elseif timer "timer__message" >= interval__message
                overhead "[ heal pot, out ]" 254
                settimer "timer__message" 0
            endif
        endif

        if var__heal_potion_out = 0 and diffhits >= config__emergency_hits and config__use_magery = 1 and var__regs_greater_heal = 1 and mana >= config__mana_greater_heal and not casting
            if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                hotkey "> Greater Heal/Cure Self"
                if config__sysmsg = 1
                    sysmsg "Agent: Greater Heal/Cure Self." 88
                endif
                settimer "timer__cast_start" 0

                while not casting and timer "timer__cast_start" < wait__cast_start
                    wait wait__poll
                endwhile

                if not casting and config__sysmsg = 1
                    sysmsg "Agent: no cast seen within {{wait__cast_start}} ms." 88
                endif

                for 60
                    if not casting
                        break
                    endif

                    if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                        break
                    endif

                    wait wait__poll
                endfor

                # The agent leaves its beneficial cursor up when there is nothing left to heal.
                if targetexists "beneficial" and diffhits = 0
                    hotkey "Cancel Current Target"
                    wait wait__short
                endif
            endif
        endif
    endif
