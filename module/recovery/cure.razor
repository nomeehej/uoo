# ----------------------------------------------------------------------------------------
# The trapped pouch while paralyzed, else a cure potion or the Smart Heal/Cure agent.
#
# @ hotkeys Drink Cure, > Smart Heal/Cure Self
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__mana_cure
#      Minimum current mana for the Cure agent.
# ----------------------------------------------------------------------------------------
@setvar! config__mana_cure 6


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # CURE
    #
    # Paralysis first, the one state in which nothing else can act, so the pouch goes out
    # at once. Poison next: potion first, it is instant and has no cooldown, and it goes
    # out during a cast. While any cure potion is carried the agent is not used, so mana
    # stays for Greater Heal. The agent waits for the walk bar and for warmode as
    # config__walk_guard and config__warmode_is_manual say. Its poll waits for the cast to
    # show first, as in recovery/heal.
    # ------------------------------------------------------------------------------------
    if paralyzed
        if findtype 3705 backpack 38
            yell "[Pouch"
            wait wait__short
        elseif timer "timer__message" >= interval__message
            overhead "[ pouch, out ]" 254
            settimer "timer__message" 0
        endif
    elseif poisoned and not hidden and not queued and not targetexists
        if config__use_potions = 1 and findtype "Orange Potion" self
            hotkey "Drink Cure"
            wait wait__short
        else
            if config__use_potions = 1 and timer "timer__message" >= interval__message
                overhead "[ cure pot, out ]" 254
                settimer "timer__message" 0
            endif

            if config__use_magery = 1 and var__regs_cure = 1 and mana >= config__mana_cure and not casting
                if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                    if config__walk_guard = 0 or cooldown "walk" = 0
                        hotkey "> Smart Heal/Cure Self"
                        if config__sysmsg = 1
                            sysmsg "Agent: Smart Heal/Cure Self for poison." 88
                        endif
                        settimer "timer__cast_start" 0

                        while not casting and timer "timer__cast_start" < wait__cast_start
                            wait wait__poll
                        endwhile

                        if not casting and config__sysmsg = 1
                            sysmsg "Agent: no cast seen within {{wait__cast_start}} ms." 88
                        endif

                        for 60
                            if not casting
                                break
                            endif

                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif

                            wait wait__poll
                        endfor
                    endif
                endif
            endif
        endif
    endif
